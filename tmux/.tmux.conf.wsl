##### 基本设置（WSL 通用）#####
set -g prefix C-a
unbind C-b
bind C-a send-prefix
set -g default-terminal "screen-256color"
set-option -sa terminal-overrides ',xterm-256color:RGB'

# 鼠标支持（含滚动与选择）
set -g mouse on

# 复制模式使用 vi 风格按键
setw -g mode-keys vi

# Cursor: prefer terminal color, use block for clarity
set -g cursor-style block
set -g cursor-colour default

# 复制模式快捷键（在 vim/nvim 内保持原按键）
unbind -n C-o
bind -n C-o if-shell \
  "ps -o comm= -t '#{pane_tty}' | grep -iqE '^(vim|nvim)$'" \
  "send-keys C-o" \
  "copy-mode"

# 复制模式搜索与跳转
bind / command-prompt -p "search down" "send -X search-forward '%%'"
bind ? command-prompt -p "search up" "send -X search-backward '%%'"

# 历史行数（适度增大，避免滚动卡顿）
set -g history-limit 10000

# 窗口切换
bind-key l last-window

##### Plugins（保持与主配置一致）#####
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'jimeh/tmux-themepack'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

##### tmux-yank：禁止默认绑定 y（防止被 clip.exe 覆盖）#####
set -g @yank_key 'None'

##### tmux-yank #####
# 默认 y 会 yank 并退出复制模式（copy-pipe-and-cancel）；这里改为 yank 后仍停留在复制模式（copy-pipe）
# set -g @yank_action 'copy-pipe'

##### tmux-yank：指定 Windows 剪贴板工具（UTF-8 友好）#####
set -g @clipboard 'win32yank.exe -i --crlf'
set -g @yank_selection 'clipboard'

##### Continuum settings #####
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'

##### tmux-resurrect #####
set -g @resurrect-capture-pane-contents 'on'

##### 初始化 TPM（建议靠近底部；本文件后面还有覆盖绑定）#####
run '~/.tmux/plugins/tpm/tpm'

##### 状态栏（Focus / CPU / RAM / 时间）#####
set -g status-interval 5
set -g status-right-length 200
set -g status-left-length 30

# 两行状态栏：
# - 第 1 行：正常状态栏（window 列表 + status-left/status-right）
# - 第 2 行：左侧 Codex 最近一次完成；右侧 Focus（不弹窗、不抢按键）
set -g status 2
set -g status-format[1] '#[align=left]#{?@codex_last_win,#[fg=cyan]Codex#[default]: #{@codex_last_win}#{?@codex_last_summary, | #{=/60/...:@codex_last_summary},},#[fg=cyan]Codex#[default]: -}#[align=right]#[fg=colour208,bold]Focus: #{=/60/...:@focus}#[default]'

# in .tmux.conf
set -g status-right "#(~/.tmux/plugins/tmux-continuum/scripts/continuum_save.sh) #(awk -v RS=\"\" '/^cpu / {u=$2+$4; t=$2+$4+$5; printf \"CPU: %.1f%%\", u*100/t}' /proc/stat) | #(free -m | awk '/Mem/ {printf \"RAM: %.1f%%\", $3*100/$2 }') | #(~/.config/nvim/tmux/bin/tmux-git-status \"#{pane_current_path}\") | %a %h-%d %H:%M "

##### Codex（可选）：turn 完成提示 + 快速跳回 #####
# 依赖 Codex CLI 的 notify hook（agent-turn-complete）把位置写入 tmux option：
# - @codex_last_win  / @codex_last_pane：最后一次完成的位置
# - ~/.tmux-codex-history：历史记录（用于菜单选择）
set -g @codex_history_file "$HOME/.tmux-codex-history"
# 不使用弹窗/消息条（用第 2 行状态栏显示即可）
set -g @codex_notify_mode "off" # popup | message | off

# <prefix> + C：弹出最近完成列表（最新在上），选择后跳回对应 pane
bind-key C run-shell -b 'bash "${XDG_CONFIG_HOME:-$HOME/.config}/nvim/tmux/bin/codex-tmux-menu"'

# <prefix> + J：一键跳回“最后一次完成”的 Codex pane
bind-key J run-shell -b 'bash "${XDG_CONFIG_HOME:-$HOME/.config}/nvim/tmux/bin/codex-tmux-jump-last"'

##### Focus：常驻显示“当前最重要的事”（不闪烁版） #####

# Focus 文件路径
set -g @focus_file "$HOME/.tmux-focus.md"

# 默认值
set -g @focus "-"

# Focus 展示在状态栏第 2 行右侧（只读 option，不执行命令）
# 第 1 行左侧显示 session 名称 + session id（方便辨识）
set -g status-left '#[fg=colour245][#{session_name} #{session_id}]'

# Pane 标记：显示 pane 编号/ID，并高亮“最后一次 Codex 完成”的 pane
set -g pane-border-status top
set -g pane-border-format '#[fg=colour240]#P #[fg=colour240]| #[fg=colour39]#{?@user_pane_title,#{=/24/...:@user_pane_title},-} #[fg=colour240]| #[fg=colour208]#{?@codex_pane_summary,#{=/40/...:@codex_pane_summary},-}'
# 某些 tmux 版本不支持 pane-active-border-format，使用 active-border-style 兼容
set -g pane-active-border-style 'fg=colour45'

# 手动标记：快速改 pane / window 标题（表达“正在做什么”）
bind-key T command-prompt -p "pane label" "set -p @user_pane_title '%%'"
bind-key W command-prompt -p "window name" "rename-window '%%'"

##### 启动/重载时：仅当内容变化才更新（避免闪烁） #####
run-shell -b 'bash "${XDG_CONFIG_HOME:-$HOME/.config}/nvim/tmux/bin/tmux-focus-sync"'

##### Focus 编辑快捷键：按 f 打开编辑，保存后同步首行 #####
bind-key f run-shell -b 'bash "${XDG_CONFIG_HOME:-$HOME/.config}/nvim/tmux/bin/tmux-focus-edit"'

# Popup 终端：在当前 pane 路径打开一个临时 shell
bind-key G display-popup -E -w 90% -h 85% -T "Terminal" -d "#{pane_current_path}" "bash"

##### Yank：复制后仍停留在 copy-mode（Windows UTF-8）#####
# 注意：这段必须放在 TPM 之后，确保覆盖 tmux-yank 的默认绑定
unbind-key -T copy-mode-vi y
unbind-key -T copy-mode y

bind-key -T copy-mode-vi y send -X copy-pipe "win32yank.exe -i --crlf"
bind-key -T copy-mode y     send -X copy-pipe "win32yank.exe -i --crlf"
