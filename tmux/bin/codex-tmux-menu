#!/usr/bin/env bash
set -euo pipefail

# Show a tmux menu for recent Codex completions (newest first) and jump back.
# History is appended by tmux/bin/codex-tmux-notify in a simple TSV file.

command -v tmux >/dev/null 2>&1 || exit 0

config_home="${XDG_CONFIG_HOME:-$HOME/.config}/nvim"
orch_dashboard="$config_home/tmux/bin/tmux-orch-dashboard"
file="$(tmux show -gv @codex_history_file 2>/dev/null || true)"
[ -n "$file" ] || file="$HOME/.tmux-codex-history"

limit="$(tmux show -gv @codex_history_limit 2>/dev/null || true)"
[ -n "$limit" ] || limit=12

tmp="$(mktemp 2>/dev/null || mktemp -t tmux-codex)"
if [ -f "$file" ]; then
  if ! tail -n "$limit" "$file" 2>/dev/null | awk '{a[NR]=$0} END{for(i=NR;i>=1;i--) print a[i]}' >"$tmp"; then
    : >"$tmp"
  fi
else
  : >"$tmp"
fi

target_pane="${TMUX_PANE:-}"
if [ -n "$target_pane" ]; then
  set -- display-menu -t "$target_pane" -T "Agents / Codex / Orch" -x R -y P
else
  set -- display-menu -T "Agents / Codex / Orch" -x R -y P
fi

menu_items=0

set -- "$@" "Orch dashboard" "O" "display-popup -E -w 90% -h 85% -T \"tmux-orch\" -d \"#{pane_current_path}\" \"bash \\\"$orch_dashboard\\\"\""
menu_items=$((menu_items + 1))

# Optional: add a "jump last" entry.
last_pane="$(tmux show -gv @codex_last_pane 2>/dev/null || true)"
last_win="$(tmux show -gv @codex_last_win 2>/dev/null || true)"
if [ -n "$last_pane" ] && [ -n "$last_win" ]; then
  last_session="${last_win%%:*}"
  set -- "$@" "Jump last: $last_win $last_pane" "L" "switch-client -t $last_session; select-window -t $last_win; select-pane -t $last_pane"
  menu_items=$((menu_items + 1))
fi

tab="$(printf "\t")"
i=1
letters=abcdef

while IFS="$tab" read -r ts win pane path col5 col6 col7; do
  [ -n "$win" ] || continue

  thread_id=""
  summary="${col5:-}"
  user_title="${col6:-}"
  # Backward-compatible parse:
  # old rows: <ts> <win> <pane> <path> <summary> <user_title>
  # new rows: <ts> <win> <pane> <path> tid:<id> <summary> <user_title>
  if [ -n "${col5:-}" ] && [ "${col5#tid:}" != "$col5" ]; then
    thread_id="${col5#tid:}"
    summary="${col6:-}"
    user_title="${col7:-}"
  fi

  short="${path##*/}"
  [ -n "$short" ] || short="$path"

  if [ "$i" -le 9 ]; then
    key="$i"
  else
    idx=$((i - 9))
    key="$(printf "%s" "$letters" | cut -c "$idx" 2>/dev/null || true)"
    [ -n "$key" ] || key=""
  fi

  if [ -z "${user_title:-}" ] && [ -n "${pane:-}" ]; then
    user_title="$(tmux show -pv -t "$pane" @user_pane_title 2>/dev/null || true)"
  fi

  title_col="${user_title:-}"
  [ -n "$title_col" ] || title_col="-"
  thread_col="${thread_id:--}"
  label="$title_col | $thread_col | $win $short"
  [ -n "${summary:-}" ] && label="$label | $summary"
  # display-menu treats labels as tmux formats; escape '#' to avoid accidental expansions.
  label="${label//#/##}"

  session="${win%%:*}"
  cmd="switch-client -t $session; select-window -t $win; select-pane -t $pane"
  set -- "$@" "$label" "$key" "$cmd"
  i=$((i + 1))
  menu_items=$((menu_items + 1))
done <"$tmp"

rm -f "$tmp"

[ "$menu_items" -gt 0 ] || {
  tmux display-message "Codex: no menu entries"
  exit 0
}

tmux "$@"
