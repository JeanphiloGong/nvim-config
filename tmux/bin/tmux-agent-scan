#!/usr/bin/env python3
import argparse
import json
import os
import re
import subprocess
import time


AGENTS = {
    "pi": "pi",
    "claude": "claude",
    "claude-code": "claude",
    "codex": "codex",
    "gemini": "gemini",
    "cursor": "cursor",
    "cline": "cline",
    "opencode": "opencode",
    "open-code": "opencode",
    "github-copilot": "copilot",
    "ghcs": "copilot",
    "kimi": "kimi",
    "droid": "droid",
    "amp": "amp",
    "amp-local": "amp",
}

VALID_STATES = ("blocked", "error", "stale", "review-ready", "working", "done", "idle", "unknown")
SHELL_COMMANDS = ("bash", "zsh", "fish", "sh", "dash", "ksh", "mksh", "nu")


def run(cmd, timeout=1.5):
    try:
        return subprocess.run(
            cmd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
            check=False,
        ).stdout
    except Exception:
        return ""


def tmux(*args, timeout=1.5):
    return run(["tmux", *args], timeout=timeout)


def state_file_path():
    if os.environ.get("AGENT_BOARD_STATE_FILE"):
        return os.environ["AGENT_BOARD_STATE_FILE"]
    state_home = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(state_home, "agent-board", "panes.json")


def load_state_table():
    try:
        with open(state_file_path(), "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except Exception:
        return {}
    if not isinstance(data, dict):
        return {}
    panes = data.get("panes")
    if isinstance(panes, dict):
        return panes
    return data


def agent_from_name(name):
    key = os.path.basename(name or "").lower()
    return AGENTS.get(key)


def agent_from_args(args):
    lower = (args or "").lower()
    if "@openai/codex" in lower or re.search(r"(^|[/\s])codex($|[\s/])", lower):
        return "codex"
    if re.search(r"(^|[/\s])claude(-code)?($|[\s/])", lower):
        return "claude"
    if re.search(r"(^|[/\s])opencode($|[\s/])", lower):
        return "opencode"
    if re.search(r"(^|[/\s])gemini($|[\s/])", lower):
        return "gemini"
    if re.search(r"(^|[/\s])droid($|[\s/])", lower):
        return "droid"
    if re.search(r"(^|[/\s])amp(-local)?($|[\s/])", lower):
        return "amp"
    return None


def process_agents_by_tty():
    out = run(["ps", "-eo", "tty=", "-o", "comm=", "-o", "args="], timeout=2.0)
    by_tty = {}
    for line in out.splitlines():
        parts = line.strip().split(None, 2)
        if len(parts) < 2:
            continue
        tty = parts[0]
        if tty == "?":
            continue
        comm = parts[1]
        args = parts[2] if len(parts) > 2 else ""
        agent = agent_from_name(comm) or agent_from_args(args)
        if not agent:
            continue
        score = 3 if agent_from_name(comm) else 2
        current = by_tty.get(tty)
        if current is None or score > current[0]:
            by_tty[tty] = (score, agent)
    return {tty: value[1] for tty, value in by_tty.items()}


def read_codex_session_from_pid(pid):
    try:
        with open(f"/proc/{pid}/environ", "rb") as fh:
            data = fh.read().split(b"\0")
    except Exception:
        return ""
    thread_id = ""
    for item in data:
        try:
            key, value = item.split(b"=", 1)
        except ValueError:
            continue
        if key == b"CODEX_SESSION_ID" and value:
            return value.decode("utf-8", errors="replace")
        if key == b"CODEX_THREAD_ID" and value and not thread_id:
            thread_id = value.decode("utf-8", errors="replace")
    return thread_id


def process_codex_sessions_by_tty():
    out = run(["ps", "-eo", "tty=", "-o", "pid=", "-o", "comm=", "-o", "args="], timeout=2.0)
    by_tty = {}
    for line in out.splitlines():
        parts = line.strip().split(None, 3)
        if len(parts) < 3:
            continue
        tty = parts[0]
        if tty == "?":
            continue
        pid = parts[1]
        comm = parts[2]
        args = parts[3] if len(parts) > 3 else ""
        agent = agent_from_name(comm) or agent_from_args(args)
        if agent != "codex":
            continue
        session_id = read_codex_session_from_pid(pid)
        if session_id:
            by_tty[tty] = session_id
    return by_tty


def detect_state(agent, hook_state="", hook_updated="", hook_ttl=3600):
    if hook_state in VALID_STATES:
        try:
            age = int(time.time()) - int(hook_updated or "0")
        except ValueError:
            age = hook_ttl + 1
        if age <= hook_ttl:
            return hook_state, "report"
        if hook_state == "working":
            return "stale", "report"

    if agent:
        return "idle", "scan"
    return "unknown", "scan"


def record_value(record, key, fallback=""):
    if isinstance(record, dict):
        value = record.get(key)
        if value not in (None, ""):
            return str(value)
    return fallback or ""


def record_list(record, key):
    if isinstance(record, dict) and isinstance(record.get(key), list):
        return record[key]
    return []


def restore_record_id(record, pane_id):
    codex_session_id = record_value(record, "codex_session_id")
    if codex_session_id:
        return "codex:" + codex_session_id
    return "pane:" + (record_value(record, "pane_id", pane_id) or "-")


def is_shell_command(command):
    return os.path.basename(command or "") in SHELL_COMMANDS


def same_restore_location(record, pane):
    record_session = record_value(record, "session_name")
    record_window = record_value(record, "window_index")
    record_window_name = record_value(record, "window_name")
    record_pane = record_value(record, "pane_index")
    record_cwd = record_value(record, "cwd")
    if record_session and record_session != pane.get("session", ""):
        return False
    if record_pane and record_pane != pane.get("pane_index", ""):
        return False
    if record_cwd and record_cwd != pane.get("path", ""):
        return False
    if record_window and record_window == pane.get("window", ""):
        return True
    if record_window_name and record_window_name == pane.get("window_name", ""):
        return True
    return False


def classify_restore_records(state_table, panes):
    live_by_pane_id = {pane.get("pane_id", ""): pane for pane in panes if pane.get("pane_id")}
    live_by_codex_session = {}
    for pane in panes:
        live_session_id = pane.get("live_codex_session_id") or ""
        if live_session_id:
            live_by_codex_session[live_session_id] = pane

    items = []
    for pane_key, record in state_table.items():
        if not isinstance(record, dict):
            continue
        if record_value(record, "agent") != "codex" and not record_value(record, "codex_session_id"):
            continue

        codex_session_id = record_value(record, "codex_session_id")
        old_pane_id = record_value(record, "pane_id", pane_key)
        matched = None
        match_reason = ""

        if old_pane_id in live_by_pane_id and same_restore_location(record, live_by_pane_id[old_pane_id]):
            matched = live_by_pane_id[old_pane_id]
            match_reason = "same-pane-location"
        if not matched and codex_session_id and codex_session_id in live_by_codex_session:
            matched = live_by_codex_session[codex_session_id]
            match_reason = "same-codex-session"
        if not matched:
            for pane in panes:
                if same_restore_location(record, pane):
                    matched = pane
                    match_reason = "same-location"
                    break

        status = ""
        reason = ""
        restorable = False
        target_pane_id = matched.get("pane_id", "") if matched else ""

        if not codex_session_id:
            status = "missing-session-id"
            reason = "record has no codex_session_id"
        elif not matched:
            status = "missing-pane"
            reason = "no existing tmux pane matches the saved location"
        elif matched.get("live_agent") == "codex" or matched.get("live_codex_session_id"):
            status = "already-running"
            reason = "matched pane is already running Codex"
        elif matched.get("pane_dead") or is_shell_command(matched.get("command")):
            status = "restorable-existing-pane"
            reason = "matched pane exists and can receive codex resume"
            restorable = True
        else:
            status = "occupied-pane"
            reason = "matched pane is running another command"

        items.append(
            {
                "restore_id": restore_record_id(record, pane_key),
                "status": status,
                "reason": reason,
                "restorable": restorable,
                "match_reason": match_reason,
                "target_pane_id": target_pane_id,
                "codex_session_id": codex_session_id,
                "last_pane_id": old_pane_id,
                "last_target": record_value(record, "last_target"),
                "session_name": record_value(record, "session_name"),
                "window_index": record_value(record, "window_index"),
                "window_name": record_value(record, "window_name"),
                "pane_index": record_value(record, "pane_index"),
                "cwd": record_value(record, "cwd"),
                "command": record_value(record, "command"),
                "goal": record_value(record, "goal"),
                "updated": record_value(record, "updated"),
            }
        )

    order = {
        "restorable-existing-pane": 0,
        "missing-session-id": 1,
        "occupied-pane": 2,
        "missing-pane": 3,
        "already-running": 4,
    }
    items.sort(key=lambda item: (order.get(item["status"], 9), item.get("last_target", ""), item.get("restore_id", "")))
    return {
        "items": items,
        "counts": {
            status: sum(1 for item in items if item["status"] == status)
            for status in (
                "already-running",
                "restorable-existing-pane",
                "missing-pane",
                "occupied-pane",
                "missing-session-id",
            )
        },
    }


def scan(show_all=False):
    fmt = "\t".join(
        [
            "#{session_name}",
            "#{session_id}",
            "#{window_index}",
            "#{window_id}",
            "#{window_name}",
            "#{pane_index}",
            "#{pane_id}",
            "#{pane_current_command}",
            "#{pane_current_path}",
            "#{pane_title}",
            "#{pane_tty}",
            "#{pane_dead}",
            "#{@user_pane_title}",
            "#{@agent_status_agent}",
            "#{@agent_status_state}",
            "#{@agent_status_phase}",
            "#{@agent_status_message}",
            "#{@agent_status_goal}",
            "#{@agent_status_need}",
            "#{@agent_status_outcome}",
            "#{@agent_status_updated}",
            "#{@agent_status_source}",
            "#{@codex_pane_thread_id}",
            "#{@codex_pane_activity}",
            "#{@codex_pane_summary}",
        ]
    )
    out = tmux("list-panes", "-a", "-F", fmt, timeout=2.0)
    state_table = load_state_table()
    tty_agents = process_agents_by_tty()
    tty_codex_sessions = process_codex_sessions_by_tty()
    hook_ttl_raw = tmux("show", "-gv", "@agent_status_hook_ttl").strip()
    try:
        hook_ttl = int(hook_ttl_raw or "3600")
    except ValueError:
        hook_ttl = 3600

    panes = []
    for line in out.splitlines():
        fields = line.split("\t")
        if len(fields) != 25:
            continue
        (
            session,
            session_id,
            window_index,
            window_id,
            window_name,
            pane_index,
            pane_id,
            command,
            path,
            title,
            tty,
            pane_dead,
            user_title,
            opt_agent,
            opt_state,
            opt_phase,
            opt_message,
            opt_goal,
            opt_need,
            opt_outcome,
            opt_updated,
            opt_source,
            opt_codex_thread_id,
            opt_activity,
            opt_summary,
        ) = fields

        record = state_table.get(pane_id, {})
        hook_agent = record_value(record, "agent", opt_agent)
        hook_state = record_value(record, "state", opt_state)
        phase = record_value(record, "phase", opt_phase)
        hook_message = record_value(record, "message", opt_message)
        goal = record_value(record, "goal", opt_goal)
        need = record_value(record, "need", opt_need)
        outcome = record_value(record, "outcome", opt_outcome)
        headline = record_value(record, "headline")
        current = record_value(record, "current")
        evidence = record_value(record, "evidence")
        next_step = record_value(record, "next")
        blocked = record_value(record, "blocked")
        brief_outcome = record_value(record, "brief_outcome")
        brief_updated = record_value(record, "brief_updated")
        codex_session_id = record_value(record, "codex_session_id", opt_codex_thread_id)
        live_codex_session_id = opt_codex_thread_id or tty_codex_sessions.get(tty.removeprefix("/dev/"), "")
        attention = record_value(record, "attention")
        plan = record_list(record, "plan")
        hook_updated = record_value(record, "updated", opt_updated)
        hook_source = record_value(record, "source", opt_source)
        activity = headline or current or opt_activity or hook_message
        summary = opt_summary

        live_agent = (
            agent_from_name(command)
            or tty_agents.get(tty.removeprefix("/dev/"))
            or agent_from_args(title)
        )
        agent = hook_agent or live_agent
        if not agent and not show_all:
            continue

        state, source = detect_state(agent, hook_state, hook_updated, hook_ttl)
        if attention in VALID_STATES and source == "report" and state != "stale":
            state = attention
        label = user_title or os.path.basename(path) or command or "-"
        detail = headline or current or activity or brief_outcome or outcome or summary or hook_message
        if detail:
            label = f"{label} | {detail}"

        panes.append(
            {
                "session": session,
                "session_id": session_id,
                "window": window_index,
                "window_id": window_id,
                "window_name": window_name,
                "pane_index": pane_index,
                "pane_id": pane_id,
                "command": command,
                "path": path,
                "title": title,
                "tty": tty,
                "pane_dead": pane_dead == "1",
                "agent": agent or "-",
                "live_agent": live_agent or "-",
                "state": state,
                "source": source,
                "report_source": hook_source,
                "label": label,
                "phase": phase,
                "goal": goal,
                "need": need,
                "outcome": outcome,
                "updated": hook_updated,
                "activity": activity or hook_message,
                "summary": summary,
                "message": hook_message,
                "attention": attention,
                "headline": headline,
                "plan": plan,
                "current": current,
                "evidence": evidence,
                "next": next_step,
                "blocked": blocked,
                "brief_outcome": brief_outcome,
                "brief_updated": brief_updated,
                "codex_session_id": codex_session_id,
                "live_codex_session_id": live_codex_session_id,
            }
        )

    severity = {
        "blocked": 0,
        "error": 1,
        "stale": 2,
        "review-ready": 3,
        "working": 4,
        "done": 5,
        "idle": 6,
        "unknown": 7,
    }
    panes.sort(
        key=lambda pane: (
            severity.get(pane["state"], 9),
            pane["session"],
            int(pane["window"]),
            int(pane["pane_index"]),
        )
    )
    return {
        "generated_at": int(time.time()),
        "show_all": show_all,
        "panes": panes,
        "restore": classify_restore_records(state_table, panes),
        "counts": {
            state: sum(1 for pane in panes if pane["state"] == state)
            for state in VALID_STATES
        },
    }


def main():
    parser = argparse.ArgumentParser(description="Scan tmux panes for agent state")
    parser.add_argument("--all", action="store_true", help="include panes without detected agents")
    parser.add_argument("--pretty", action="store_true", help="pretty-print JSON")
    args = parser.parse_args()

    data = scan(show_all=args.all)
    if args.pretty:
        print(json.dumps(data, ensure_ascii=False, indent=2))
    else:
        print(json.dumps(data, ensure_ascii=False, separators=(",", ":")))


if __name__ == "__main__":
    main()
