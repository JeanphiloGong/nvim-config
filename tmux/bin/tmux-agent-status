#!/usr/bin/env bash
set -euo pipefail

command -v tmux >/dev/null 2>&1 || exit 0

state_file_path() {
  if [ -n "${AGENT_BOARD_STATE_FILE:-}" ]; then
    printf '%s\n' "$AGENT_BOARD_STATE_FILE"
    return
  fi
  printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/agent-board/panes.json"
}

valid_state() {
  case "${1:-}" in
    idle | working | blocked | review-ready | done | error | stale | unknown) return 0 ;;
    *) return 1 ;;
  esac
}

update_state_file() {
  command -v python3 >/dev/null 2>&1 || return 0
  local file
  file="$(state_file_path)"
  mkdir -p "$(dirname "$file")" 2>/dev/null || return 0

  local session_name="" window_index="" window_name="" pane_index="" cwd="" command="" last_target=""
  session_name="$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null || true)"
  window_index="$(tmux display-message -p -t "$pane" '#{window_index}' 2>/dev/null || true)"
  window_name="$(tmux display-message -p -t "$pane" '#{window_name}' 2>/dev/null || true)"
  pane_index="$(tmux display-message -p -t "$pane" '#{pane_index}' 2>/dev/null || true)"
  cwd="$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null || true)"
  command="$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || true)"
  if [ -n "$session_name" ] && [ -n "$window_index" ] && [ -n "$pane_index" ]; then
    last_target="${session_name}:${window_index}.${pane_index}"
  fi

  python3 - "$file" "$pane" "$agent" "$state" "$phase" "$phase_set" "$message" "$goal" "$goal_set" "$need" "$need_set" "$outcome" "$outcome_set" "$source" "$codex_session_id" "$codex_session_id_set" "$session_name" "$window_index" "$window_name" "$pane_index" "$cwd" "$command" "$last_target" <<'PY' 2>/dev/null || true
import fcntl
import json
import os
import sys
import time

(
    path,
    pane,
    agent,
    state,
    phase,
    phase_set,
    message,
    goal,
    goal_set,
    need,
    need_set,
    outcome,
    outcome_set,
    source,
    codex_session_id,
    codex_session_id_set,
    session_name,
    window_index,
    window_name,
    pane_index,
    cwd,
    command,
    last_target,
) = sys.argv[1:24]

lock_path = path + ".lock"
os.makedirs(os.path.dirname(path), exist_ok=True)

with open(lock_path, "w", encoding="utf-8") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        with open(path, "r", encoding="utf-8") as fh:
            table = json.load(fh)
    except Exception:
        table = {}
    if not isinstance(table, dict):
        table = {}

    record = table.get(pane)
    if not isinstance(record, dict):
        record = {}

    record.update(
        {
            "pane_id": pane,
            "agent": agent,
            "state": state,
            "message": message,
            "updated": int(time.time()),
            "source": source,
        }
    )
    if phase_set == "1":
        record["phase"] = phase
    if goal_set == "1":
        record["goal"] = goal
    if need_set == "1":
        record["need"] = need
    if outcome_set == "1":
        record["outcome"] = outcome
    if codex_session_id_set == "1":
        record["codex_session_id"] = codex_session_id
    for key, value in (
        ("session_name", session_name),
        ("window_index", window_index),
        ("window_name", window_name),
        ("pane_index", pane_index),
        ("cwd", cwd),
        ("command", command),
        ("last_target", last_target),
    ):
        if value:
            record[key] = value

    table[pane] = record
    tmp = path + ".tmp." + str(os.getpid())
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(table, fh, ensure_ascii=False, separators=(",", ":"))
        fh.write("\n")
    os.replace(tmp, path)
PY
}

clear_state_file() {
  command -v python3 >/dev/null 2>&1 || return 0
  local pane="$1"
  local file
  file="$(state_file_path)"
  [ -f "$file" ] || return 0

  python3 - "$file" "$pane" <<'PY' 2>/dev/null || true
import fcntl
import json
import os
import sys

path, pane = sys.argv[1:3]
lock_path = path + ".lock"

with open(lock_path, "w", encoding="utf-8") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        with open(path, "r", encoding="utf-8") as fh:
            table = json.load(fh)
    except Exception:
        table = {}
    if isinstance(table, dict) and pane in table:
        table.pop(pane, None)
        tmp = path + ".tmp." + str(os.getpid())
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(table, fh, ensure_ascii=False, separators=(",", ":"))
            fh.write("\n")
        os.replace(tmp, path)
PY
}

clear_report() {
  local pane="${1:-${TMUX_PANE:-}}"
  [ -n "$pane" ] || exit 0

  tmux set-option -pqu -t "$pane" @agent_status_agent 2>/dev/null || true
  tmux set-option -pqu -t "$pane" @agent_status_state 2>/dev/null || true
  tmux set-option -pqu -t "$pane" @agent_status_phase 2>/dev/null || true
  tmux set-option -pqu -t "$pane" @agent_status_message 2>/dev/null || true
  tmux set-option -pqu -t "$pane" @agent_status_goal 2>/dev/null || true
  tmux set-option -pqu -t "$pane" @agent_status_need 2>/dev/null || true
  tmux set-option -pqu -t "$pane" @agent_status_outcome 2>/dev/null || true
  tmux set-option -pqu -t "$pane" @agent_status_updated 2>/dev/null || true
  tmux set-option -pqu -t "$pane" @agent_status_source 2>/dev/null || true
  clear_state_file "$pane"
}

report_state() {
  local pane="${TMUX_PANE:-}"
  local agent=""
  local state=""
  local phase=""
  local message=""
  local goal=""
  local need=""
  local outcome=""
  local source="manual"
  local codex_session_id=""
  local phase_set=0
  local goal_set=0
  local need_set=0
  local outcome_set=0
  local codex_session_id_set=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --pane)
        pane="${2:-}"
        shift 2
        ;;
      --agent)
        agent="${2:-}"
        shift 2
        ;;
      --state)
        state="${2:-}"
        shift 2
        ;;
      --phase)
        phase="${2:-}"
        phase_set=1
        shift 2
        ;;
      --message)
        message="${2:-}"
        shift 2
        ;;
      --goal)
        goal="${2:-}"
        goal_set=1
        shift 2
        ;;
      --need)
        need="${2:-}"
        need_set=1
        shift 2
        ;;
      --outcome)
        outcome="${2:-}"
        outcome_set=1
        shift 2
        ;;
      --source)
        source="${2:-}"
        shift 2
        ;;
      --codex-session-id)
        codex_session_id="${2:-}"
        codex_session_id_set=1
        shift 2
        ;;
      --clear | --release)
        clear_report "$pane"
        exit 0
        ;;
      *)
        exit 2
        ;;
    esac
  done

  [ -n "$pane" ] || exit 0
  [ -n "$agent" ] || agent="agent"
  valid_state "$state" || exit 2

  tmux set -pq -t "$pane" @agent_status_agent "$agent" 2>/dev/null || true
  tmux set -pq -t "$pane" @agent_status_state "$state" 2>/dev/null || true
  [ "$phase_set" -eq 1 ] && tmux set -pq -t "$pane" @agent_status_phase "$phase" 2>/dev/null || true
  tmux set -pq -t "$pane" @agent_status_message "$message" 2>/dev/null || true
  [ "$goal_set" -eq 1 ] && tmux set -pq -t "$pane" @agent_status_goal "$goal" 2>/dev/null || true
  [ "$need_set" -eq 1 ] && tmux set -pq -t "$pane" @agent_status_need "$need" 2>/dev/null || true
  [ "$outcome_set" -eq 1 ] && tmux set -pq -t "$pane" @agent_status_outcome "$outcome" 2>/dev/null || true
  tmux set -pq -t "$pane" @agent_status_updated "$(date +%s)" 2>/dev/null || true
  tmux set -pq -t "$pane" @agent_status_source "$source" 2>/dev/null || true
  update_state_file
}

case "${1:-}" in
  report)
    shift
    report_state "$@"
    ;;
  clear)
    shift
    clear_report "${1:-${TMUX_PANE:-}}"
    ;;
  *)
    printf 'usage: tmux-agent-status report --pane PANE --agent NAME --state STATE [--phase PHASE] [--message TEXT] [--codex-session-id ID]\n' >&2
    exit 2
    ;;
esac
