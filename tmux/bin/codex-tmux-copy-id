#!/usr/bin/env bash
set -euo pipefail

# Copy a Codex thread/session id to tmux buffer and, when possible,
# to the system clipboard as well.

thread_id="${1:-}"
[ -n "$thread_id" ] || exit 0
command -v tmux >/dev/null 2>&1 || exit 0

tmux set-buffer -- "$thread_id" 2>/dev/null || true

if command -v pbcopy >/dev/null 2>&1; then
  printf '%s' "$thread_id" | pbcopy
elif command -v wl-copy >/dev/null 2>&1; then
  printf '%s' "$thread_id" | wl-copy
elif command -v xclip >/dev/null 2>&1; then
  printf '%s' "$thread_id" | xclip -selection clipboard
elif command -v xsel >/dev/null 2>&1; then
  printf '%s' "$thread_id" | xsel --clipboard --input
elif command -v win32yank.exe >/dev/null 2>&1; then
  printf '%s' "$thread_id" | win32yank.exe -i --crlf
fi

short_id="$thread_id"
[ "${#short_id}" -gt 8 ] && short_id="${short_id:0:8}"
tmux display-message "Codex tid copied: $short_id"
