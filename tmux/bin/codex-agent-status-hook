#!/usr/bin/env bash
set -euo pipefail

payload=""
if [ ! -t 0 ]; then
  payload="$(cat 2>/dev/null || true)"
fi

state="${1:-}"
emit_stop_output=0

if [ "${2:-}" = "--stop" ]; then
  emit_stop_output=1
fi

finish() {
  if [ "$emit_stop_output" -eq 1 ]; then
    printf '{"continue":true,"suppressOutput":true}\n'
  fi
  exit 0
}

[ "${AGENT_BOARD_SUMMARIZER:-}" = "1" ] && finish

case "$state" in
  idle | working | blocked | done | unknown) ;;
  clear | release) ;;
  *) exit 0 ;;
esac

[ -n "${TMUX:-}" ] || finish
[ -n "${TMUX_PANE:-}" ] || finish

status_bin="${XDG_CONFIG_HOME:-$HOME/.config}/nvim/tmux/bin/tmux-agent-status"
[ -x "$status_bin" ] || finish
brief_bin="${XDG_CONFIG_HOME:-$HOME/.config}/nvim/tmux/bin/tmux-agent-brief"

metadata_from_payload() {
  command -v python3 >/dev/null 2>&1 || return 0
  local payload_file
  payload_file="$(mktemp "${TMPDIR:-/tmp}/codex-agent-status.XXXXXX")" || return 0
  printf '%s' "$payload" >"$payload_file" 2>/dev/null || {
    rm -f "$payload_file"
    return 0
  }
python3 - "$state" "$payload_file" <<'PY' 2>/dev/null || true
import json
import re
import sys

state = sys.argv[1]
with open(sys.argv[2], "r", encoding="utf-8", errors="replace") as fh:
    raw = fh.read()

try:
    data = json.loads(raw) if raw.strip() else {}
except Exception:
    data = {}

def pick(obj, *keys):
    if not isinstance(obj, dict):
        return ""
    for key in keys:
        if key in obj and obj[key] not in (None, ""):
            return obj[key]
    normalized = {str(key).replace("-", "_").lower(): value for key, value in obj.items()}
    for key in keys:
        value = normalized.get(str(key).replace("-", "_").lower())
        if value not in (None, ""):
            return value
    return ""

def clean(value, limit=96):
    if isinstance(value, (dict, list)):
        value = json.dumps(value, ensure_ascii=False, separators=(",", ":"))
    if value is None:
        value = ""
    value = re.sub(r"\s+", " ", str(value)).strip()
    value = re.sub(r"[\x00-\x1f\x7f]", "", value)
    if len(value) > limit:
        value = value[: max(0, limit - 1)].rstrip() + "..."
    return value

def message_text(value, limit=96):
    if isinstance(value, dict):
        value = pick(value, "content", "text", "message")
    elif isinstance(value, list):
        parts = []
        for item in value:
            text = message_text(item, limit)
            if text:
                parts.append(text)
        value = " ".join(parts)
    return clean(value, limit)

event = clean(pick(data, "hook_event_name", "hookEventName", "hook-event-name"), 32)
tool = clean(pick(data, "tool_name", "toolName", "tool-name"), 32)
tool_input = pick(data, "tool_input", "toolInput", "tool-input")
tool_input = tool_input if isinstance(tool_input, dict) else {}
command = ""
description = ""
target = ""
if isinstance(tool_input, dict):
    command = clean(pick(tool_input, "command", "cmd"), 96)
    description = clean(pick(tool_input, "description"), 96)
    target = clean(pick(tool_input, "file_path", "filePath", "path", "query", "pattern"), 64)

prompt = clean(pick(data, "prompt", "user_prompt", "userPrompt", "user-prompt"), 96)
last_message = message_text(pick(data, "last_assistant_message", "lastAssistantMessage", "last-assistant-message"), 96)
source = clean(pick(data, "source"), 32)

def phase_for_tool(tool_key, command="", description="", target=""):
    text = " ".join([tool_key, command, description, target]).lower()
    if re.search(r"\b(pytest|bats|cargo test|go test|npm test|pnpm test|yarn test|vitest|jest|rspec)\b", text):
        return "testing"
    if re.search(r"\bgit\s+(add|commit|status|diff|show|log)\b", text):
        return "committing" if re.search(r"\bgit\s+(add|commit)\b", text) else "inspecting"
    if tool_key in {"apply_patch", "edit", "multiedit", "write"}:
        return "editing"
    if tool_key in {"read", "glob", "grep", "ls"}:
        return "inspecting"
    return "inspecting"

def is_control_prompt(text):
    value = (text or "").strip()
    lower = value.lower()
    if lower in {"continue"} or value in {"继续", "继续吧"}:
        return True
    if "$git-commit-skill" in lower:
        return True
    if re.search(r"\bstage\s+and\s+commit\b|\bgit\s+commit\b", lower):
        return True
    return False

health = state
phase = "unknown"
goal = ""
activity = ""
summary = ""
need = ""
outcome = ""
tool_key = tool.lower()

if event == "SessionStart":
    health = "idle"
    phase = "complete"
    activity = f"idle: {source or 'session'}"
elif event == "UserPromptSubmit":
    health = "working"
    phase = "intake"
    if not is_control_prompt(prompt):
        goal = prompt
    activity = f"request: {prompt or 'submitted'}"
elif event == "PreToolUse":
    health = "working"
    phase = phase_for_tool(tool_key, command, description, target)
    if tool_key == "bash" and command:
        prefix = "test" if phase == "testing" else "shell"
        activity = f"{prefix}: {description or command}"
    elif tool_key in {"apply_patch", "edit", "multiedit", "write"}:
        activity = f"edit: {target or tool or 'file'}"
    elif tool_key in {"read", "glob", "grep", "ls"}:
        activity = f"inspect: {target or tool}"
    elif tool:
        activity = f"tool: {tool}"
    else:
        activity = "working"
elif event == "PermissionRequest":
    health = "blocked"
    phase = "waiting"
    need = description or tool or "permission"
    if description:
        activity = f"blocked: {description}"
    elif tool:
        activity = f"blocked: {tool}"
    else:
        activity = "blocked"
elif event == "PostToolUse":
    health = "working"
    phase = phase_for_tool(tool_key, command, description, target)
    activity = f"used: {tool or 'tool'}"
elif event == "Stop":
    health = "review-ready"
    phase = "reporting"
    summary = last_message
    outcome = summary
    activity = f"ready: {summary}" if summary else "ready for review"
elif state:
    if state == "done" and last_message:
        health = "review-ready"
        phase = "reporting"
        summary = last_message
        outcome = summary
        activity = f"ready: {summary}"
    else:
        phase = "unknown"
        activity = state

for value in (health, phase, goal, activity, summary, need, outcome):
    print(value)
PY
  rm -f "$payload_file"
}

metadata="$(metadata_from_payload)"
metadata_fields=()
activity=""
summary=""
health_state="$state"
phase=""
goal=""
need=""
outcome=""
if [ -n "$metadata" ]; then
  mapfile -t metadata_fields <<<"$metadata"
  health_state="${metadata_fields[0]:-$state}"
  phase="${metadata_fields[1]:-}"
  goal="${metadata_fields[2]:-}"
  activity="${metadata_fields[3]:-}"
  summary="${metadata_fields[4]:-}"
  need="${metadata_fields[5]:-}"
  outcome="${metadata_fields[6]:-}"
fi
[ -n "$activity" ] || activity="$state"
case "$health_state" in
  idle | working | blocked | review-ready | done | error | stale | unknown) ;;
  *) health_state="$state" ;;
esac

case "$state" in
  clear | release)
    "$status_bin" clear "$TMUX_PANE" >/dev/null 2>&1 || true
    if [ -x "$brief_bin" ]; then
      "$brief_bin" clear --pane "$TMUX_PANE" >/dev/null 2>&1 || true
    fi
    tmux set-option -pqu -t "$TMUX_PANE" @codex_pane_activity 2>/dev/null || true
    tmux set-option -pqu -t "$TMUX_PANE" @codex_pane_summary 2>/dev/null || true
    tmux select-pane -t "$TMUX_PANE" -T "" 2>/dev/null || true
    ;;
  *)
    report_args=(
      report
      --pane "$TMUX_PANE" \
      --agent codex \
      --state "$health_state" \
      --phase "$phase" \
      --message "$activity" \
      --source codex-hook
    )
    if [ -n "$goal" ] || [ "$phase" = "complete" ]; then
      report_args+=(--goal "$goal")
    fi
    if [ -n "$need" ] || [ "$health_state" != "blocked" ]; then
      report_args+=(--need "$need")
    fi
    if [ -n "$outcome" ] || [ "$phase" = "intake" ] || [ "$phase" = "complete" ] || [ "$health_state" = "working" ]; then
      report_args+=(--outcome "$outcome")
    fi
    "$status_bin" "${report_args[@]}" >/dev/null 2>&1 || true
    if [ -x "$brief_bin" ]; then
      printf '%s' "$payload" | "$brief_bin" event \
        --pane "$TMUX_PANE" \
        --agent codex \
        --state "$health_state" \
        --phase "$phase" \
        --message "$activity" \
        --goal "$goal" \
        --need "$need" \
        --outcome "$outcome" \
        --source codex-hook >/dev/null 2>&1 || true
    fi
    tmux set -pq -t "$TMUX_PANE" @codex_pane_activity "$activity" 2>/dev/null || true
    if [ -n "$summary" ]; then
      tmux set -pq -t "$TMUX_PANE" @codex_pane_summary "$summary" 2>/dev/null || true
    fi
    tmux select-pane -t "$TMUX_PANE" -T "$activity" 2>/dev/null || true
    ;;
esac

tmux refresh-client -S 2>/dev/null || true

finish
