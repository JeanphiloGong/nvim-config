#!/usr/bin/env python3
import argparse
import json
import os
import re
import subprocess
import sys
import time


def state_root():
    if os.environ.get("AGENT_BOARD_STATE_HOME"):
        return os.environ["AGENT_BOARD_STATE_HOME"]
    state_home = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(state_home, "agent-board")


def safe_window_id(window_id):
    cleaned = re.sub(r"[^A-Za-z0-9_.@-]+", "_", window_id or "")
    return cleaned or "unknown"


def plan_path(window_id):
    return os.path.join(state_root(), "plans", safe_window_id(window_id) + ".json")


def tmux(*args, timeout=2.0):
    try:
        return subprocess.run(
            ["tmux", *args],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
    except Exception as exc:
        return subprocess.CompletedProcess(["tmux", *args], 1, "", str(exc))


def current_window_id():
    proc = tmux("display-message", "-p", "#{window_id}")
    return proc.stdout.strip()


def capture_pane(pane_id, history_lines):
    proc = tmux("capture-pane", "-p", "-J", "-S", "-" + str(history_lines), "-t", pane_id, timeout=5.0)
    if proc.returncode != 0:
        raise SystemExit("failed to capture pane: " + (proc.stderr.strip() or pane_id))
    return proc.stdout


def load_plan(window_id):
    path = plan_path(window_id)
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except Exception:
        return {
            "schema": 1,
            "window_id": window_id,
            "tasks": [],
            "raw_text": "",
            "source": {},
            "updated_at": 0,
        }
    if not isinstance(data, dict):
        return {"schema": 1, "window_id": window_id, "tasks": [], "raw_text": "", "source": {}, "updated_at": 0}
    data.setdefault("schema", 1)
    data["window_id"] = window_id
    data.setdefault("tasks", [])
    data.setdefault("raw_text", "")
    data.setdefault("source", {})
    data.setdefault("updated_at", 0)
    return data


def write_plan(window_id, data):
    path = plan_path(window_id)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp." + str(os.getpid())
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, ensure_ascii=False, indent=2)
        fh.write("\n")
    os.replace(tmp, path)


TASK_HEADING_RE = re.compile(r"^\s*#{2,5}\s*Task\s+(\d+)\s*[:：]\s*(.+?)\s*$", re.IGNORECASE)
TASK_CHECKBOX_RE = re.compile(r"^\s*[-*]\s*\[[ xX]\]\s*Task\s+(\d+)\s*[:：]\s*(.+?)\s*$", re.IGNORECASE)
FIELD_RE = re.compile(r"^\s*(?:[-*]\s*)?(?:\*\*)?([A-Za-z][A-Za-z /_-]*|验收标准|验证方式|依赖|描述)\s*[:：](?:\*\*)?\s*(.*)$")


def task_id(number, title):
    slug = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")
    if slug:
        return f"task-{number}-{slug[:40].strip('-')}"
    return f"task-{number}"


def split_task_blocks(text):
    lines = text.splitlines()
    starts = []
    for index, line in enumerate(lines):
        heading = TASK_HEADING_RE.match(line)
        checkbox = TASK_CHECKBOX_RE.match(line)
        if heading or checkbox:
            match = heading or checkbox
            starts.append((index, match.group(1), match.group(2).strip()))
    blocks = []
    for pos, (start, number, title) in enumerate(starts):
        end = starts[pos + 1][0] if pos + 1 < len(starts) else len(lines)
        blocks.append((number, title, lines[start + 1 : end]))
    return blocks


def clean_list_marker(line):
    return re.sub(r"^\s*[-*]\s*(?:\[[ xX]\]\s*)?", "", line).strip()


def normalize_field_name(name):
    key = name.strip().lower().replace("_", "-")
    if key in ("description", "描述"):
        return "description"
    if key in ("acceptance criteria", "acceptance", "验收标准"):
        return "acceptance"
    if key in ("verification", "verify", "验证方式"):
        return "verification"
    if key in ("dependencies", "dependency", "依赖"):
        return "dependencies"
    if key in ("files likely touched", "files", "estimated scope", "issue handoff"):
        return "ignore"
    return ""


def parse_block(number, title, block_lines):
    task = {
        "id": task_id(number, title),
        "number": int(number),
        "title": title,
        "status": "todo",
        "description": "",
        "acceptance": [],
        "verification": [],
        "dependencies": "",
        "assignments": [],
    }
    current = ""
    description_lines = []

    for raw_line in block_lines:
        line = raw_line.rstrip()
        if re.match(r"^\s*#{1,6}\s+", line):
            break
        field = FIELD_RE.match(line)
        if field:
            current = normalize_field_name(field.group(1))
            value = field.group(2).strip()
            if value:
                if current == "description":
                    description_lines.append(value)
                elif current == "acceptance":
                    task["acceptance"].append(clean_list_marker(value))
                elif current == "verification":
                    task["verification"].append(clean_list_marker(value))
                elif current == "dependencies":
                    task["dependencies"] = value
            continue

        stripped = line.strip()
        if not stripped:
            continue
        if current == "description":
            description_lines.append(clean_list_marker(stripped))
        elif current == "acceptance" and re.match(r"^\s*[-*]\s*", line):
            task["acceptance"].append(clean_list_marker(line))
        elif current == "verification" and re.match(r"^\s*[-*]\s*", line):
            task["verification"].append(clean_list_marker(line))
        elif current == "dependencies":
            if task["dependencies"]:
                task["dependencies"] += " " + clean_list_marker(stripped)
            else:
                task["dependencies"] = clean_list_marker(stripped)

    task["description"] = " ".join(description_lines).strip()
    task["acceptance"] = [item for item in task["acceptance"] if item]
    task["verification"] = [item for item in task["verification"] if item]
    return task


def parse_plan(text):
    tasks = [parse_block(number, title, lines) for number, title, lines in split_task_blocks(text)]
    return sorted(tasks, key=lambda task: task.get("number", 0))


def merge_tasks(old_tasks, new_tasks):
    old_by_id = {task.get("id"): task for task in old_tasks if isinstance(task, dict)}
    old_by_title = {task.get("title", ""): task for task in old_tasks if isinstance(task, dict)}
    merged = []
    for task in new_tasks:
        previous = old_by_id.get(task["id"]) or old_by_title.get(task["title"])
        if previous:
            task["status"] = previous.get("status") or task["status"]
            task["assignments"] = previous.get("assignments") if isinstance(previous.get("assignments"), list) else []
        merged.append(task)
    return merged


def output(data, pretty):
    if pretty:
        print(json.dumps(data, ensure_ascii=False, indent=2))
    else:
        print(json.dumps(data, ensure_ascii=False, separators=(",", ":")))


def cmd_status(args):
    window_id = args.window_id or current_window_id()
    if not window_id:
        raise SystemExit("--window-id is required outside tmux")
    output(load_plan(window_id), args.pretty)


def cmd_import(args):
    window_id = args.window_id or current_window_id()
    if not window_id:
        raise SystemExit("--window-id is required outside tmux")
    if args.source_pane:
        text = capture_pane(args.source_pane, args.history_lines)
    elif args.file:
        with open(args.file, "r", encoding="utf-8") as fh:
            text = fh.read()
    else:
        text = sys.stdin.read()

    old = load_plan(window_id)
    tasks = parse_plan(text)
    if not args.replace:
        tasks = merge_tasks(old.get("tasks", []), tasks)
    data = {
        "schema": 1,
        "window_id": window_id,
        "source": {
            "pane_id": args.source_pane or "",
            "file": args.file or "",
            "imported_at": int(time.time()),
        },
        "task_count": len(tasks),
        "tasks": tasks,
        "raw_text": text,
        "parse_error": "" if tasks else "no workflow-plan tasks found",
        "updated_at": int(time.time()),
    }
    write_plan(window_id, data)
    output(data, args.pretty)


def main():
    parser = argparse.ArgumentParser(description="Manage AgentBoard window plan state")
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status", help="print window plan JSON")
    status.add_argument("--window-id", default="")
    status.add_argument("--pretty", action="store_true")
    status.set_defaults(func=cmd_status)

    import_cmd = sub.add_parser("import", help="import workflow-plan text into a window plan")
    import_cmd.add_argument("--window-id", default="")
    import_cmd.add_argument("--source-pane", default="")
    import_cmd.add_argument("--file", default="")
    import_cmd.add_argument("--history-lines", type=int, default=2000)
    import_cmd.add_argument("--replace", action="store_true")
    import_cmd.add_argument("--pretty", action="store_true")
    import_cmd.set_defaults(func=cmd_import)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
