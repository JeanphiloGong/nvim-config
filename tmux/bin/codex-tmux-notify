#!/usr/bin/env bash
set -euo pipefail

# Codex CLI "notify" hook.
#
# Codex will call this command with 1 JSON argument (event payload). We don't
# need to parse it; we just record which tmux pane/window the hook ran in.

_payload="${1:-}"

# Only do work when running inside tmux.
pane="${TMUX_PANE:-}"
if [ -z "$pane" ]; then
  exit 0
fi
command -v tmux >/dev/null 2>&1 || exit 0

# Record "where Codex finished" so tmux status can show it and jump back.
win="$(tmux display-message -p -t "$pane" '#{session_name}:#{window_index}' 2>/dev/null || true)"
if [ -z "$win" ]; then
  exit 0
fi

path="$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null || true)"

# Optional: derive a short summary from the notify JSON payload.
# Keep this best-effort and dependency-light (python3 is optional).
summary=""
if [ -n "$_payload" ] && command -v python3 >/dev/null 2>&1; then
  summary="$(python3 - "$_payload" <<'PY' 2>/dev/null || true
import json, sys
try:
  payload = json.loads(sys.argv[1])
except Exception:
  sys.exit(0)

msg = payload.get("last-assistant-message") or ""
if isinstance(msg, dict):
  msg = msg.get("content") or ""
if not isinstance(msg, str):
  msg = str(msg)

msg = msg.strip()
if not msg:
  sys.exit(0)

first = msg.splitlines()[0]
first = first.replace("\t", " ").replace("\r", " ").replace("\n", " ")
print(first[:80])
PY
)"
fi

tmux set -gq @codex_last_win "$win"
tmux set -gq @codex_last_pane "$pane"
tmux set -gq @codex_last_path "$path"
[ -n "$summary" ] && tmux set -gq @codex_last_summary "$summary"
tmux refresh-client -S 2>/dev/null || true
if [ -n "$summary" ]; then
  tmux select-pane -t "$pane" -T "$summary" 2>/dev/null || true
fi

# Append to a simple history file so tmux can show a menu (latest first).
# Format (tab-separated):
#   <ts>  <session:win>  <pane_id>  <pane_path>  <summary?>
history_file="$(tmux show -gv @codex_history_file 2>/dev/null || true)"
if [ -z "$history_file" ]; then
  history_file="$HOME/.tmux-codex-history"
fi
ts="$(date '+%Y-%m-%d %H:%M:%S')"

mkdir -p "$(dirname "$history_file")" 2>/dev/null || true
touch "$history_file" 2>/dev/null || true

_append_and_trim() {
  printf '%s\t%s\t%s\t%s\t%s\n' "$ts" "$win" "$pane" "$path" "$summary" >>"$history_file" || return 0
  tmp="${history_file}.tmp.$$"
  tail -n 50 "$history_file" >"$tmp" 2>/dev/null && mv "$tmp" "$history_file"
}

if command -v flock >/dev/null 2>&1; then
  lock="${history_file}.lock"
  exec 9>"$lock" || exit 0
  flock -w 2 9 || exit 0
  _append_and_trim
else
  _append_and_trim
fi

# Notify: show a small "toast" inside tmux (not a persistent status segment).
mode="$(tmux show -gv @codex_notify_mode 2>/dev/null || true)"
[ -n "$mode" ] || mode="message"

if [ "$mode" = "message" ]; then
  # Keep it short; users can jump back via <prefix>+J / <prefix>+C.
  if [ -n "$summary" ]; then
    tmux display-message -d 5000 "Codex done: $win | $summary"
  else
    tmux display-message -d 5000 "Codex done: $win"
  fi
elif [ "$mode" = "popup" ]; then
  # A nicer in-terminal "toast": small popup that auto-closes after a moment.
  #
  # Position is configurable via @codex_popup_corner:
  #   tr|br|tl|bl (default: br)
  # NOTE: tmux popups are modal and will capture input while shown.
  # Fall back to display-message if display-popup isn't available.
  corner="$(tmux show -gv @codex_popup_corner 2>/dev/null || true)"
  [ -n "$corner" ] || corner="br"

  # Margin from the client edge (in cells). Default: 1.
  margin="$(tmux show -gv @codex_popup_margin 2>/dev/null || true)"
  [ -n "$margin" ] || margin="1"

  # These are tmux format strings (evaluated by tmux, not by the shell).
  # We anchor to the *client* (whole window), not the current pane.
  case "$corner" in
    tr)
      pos_x="#{e|-:#{e|-:#{client_width},#{popup_width}},$margin}"
      pos_y="$margin"
      ;;
    tl)
      pos_x="$margin"
      pos_y="$margin"
      ;;
    bl)
      pos_x="$margin"
      pos_y="#{e|-:#{e|-:#{client_height},#{popup_height}},$margin}"
      ;;
    br|*)
      pos_x="#{e|-:#{e|-:#{client_width},#{popup_width}},$margin}"
      pos_y="#{e|-:#{e|-:#{client_height},#{popup_height}},$margin}"
      ;;
  esac

  popup_w="$(tmux show -gv @codex_popup_width 2>/dev/null || true)"
  popup_h="$(tmux show -gv @codex_popup_height 2>/dev/null || true)"
  [ -n "$popup_w" ] || popup_w="60"
  [ -n "$popup_h" ] || popup_h="6"
  popup_dur_s="$(tmux show -gv @codex_popup_duration 2>/dev/null || true)"
  [ -n "$popup_dur_s" ] || popup_dur_s="2"

  # Use bash to print the message and sleep briefly; popup closes on exit (-E).
  # Pass the fields via env vars to avoid shell quoting issues.
  if ! tmux display-popup -E -t "$pane" -w "$popup_w" -h "$popup_h" -x "$pos_x" -y "$pos_y" -T "Codex" \
    -e "CODEX_TOAST_WIN=$win" -e "CODEX_TOAST_SUMMARY=$summary" -e "CODEX_TOAST_SLEEP=$popup_dur_s" \
    "bash -lc 'printf \"Codex done\\n%s\\n\" \"\$CODEX_TOAST_WIN\"; [ -n \"\$CODEX_TOAST_SUMMARY\" ] && printf \"%s\\n\" \"\$CODEX_TOAST_SUMMARY\"; sleep \"\$CODEX_TOAST_SLEEP\"'" 2>/dev/null; then
    tmux display-message -d 5000 "Codex done: $win${summary:+ | $summary}"
  fi
fi
