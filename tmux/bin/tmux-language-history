#!/usr/bin/env bash
set -u

history_file="${TMUX_LANG_HISTORY_FILE:-$HOME/.tmux-language-history}"
limit="${1:-30}"

if ! printf '%s' "$limit" | grep -Eq '^[0-9]+$'; then
  limit=30
fi

printf "Language history (latest %s)\n\n" "$limit"

if [ ! -s "$history_file" ]; then
  printf "No history yet.\n\n"
  printf "Press Enter to close..."
  IFS= read -r _
  exit 0
fi

tail -n "$limit" "$history_file" | awk -F '\t' '
{
  idx = NR
  ts = $1

  if (NF >= 9) {
    in_txt = $4
    en_txt = $5
    best_txt = $6
    note_txt = $7
    tip_txt = $8
    context_txt = $9
    printf "%2d. %s\n", idx, ts
    printf "  IN   : %s\n", in_txt
    printf "  EN(trans) : %s\n", en_txt
    if (note_txt != "") {
      printf "  NOTE      : %s\n", note_txt
    }
    if (tip_txt != "") {
      printf "  TIP       : %s\n", tip_txt
    }
    if (context_txt != "") {
      printf "  CONTEXT   : %s\n", context_txt
    }
    if (best_txt != "") {
      printf "\n"
      printf "  BEST(codex): %s\n", best_txt
    }
    printf "\n"
  } else if (NF >= 7) {
    in_txt = $3
    en_txt = $4
    best_txt = $5
    note_txt = $6
    tip_txt = $7
    printf "%2d. %s\n", idx, ts
    printf "  IN   : %s\n", in_txt
    printf "  EN(trans) : %s\n", en_txt
    if (note_txt != "") {
      printf "  NOTE      : %s\n", note_txt
    }
    if (tip_txt != "") {
      printf "  TIP       : %s\n", tip_txt
    }
    if (best_txt != "") {
      printf "\n"
      printf "  BEST(codex): %s\n", best_txt
    }
    printf "\n"
  } else {
    in_txt = $2
    out_txt = $3
    printf "%2d. %s\n", idx, ts
    printf "  IN : %s\n", in_txt
    printf "  OUT: %s\n\n", out_txt
  }
}
'

printf "Press Enter to close..."
IFS= read -r _
