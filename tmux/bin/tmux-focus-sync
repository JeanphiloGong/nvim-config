#!/usr/bin/env bash
set -euo pipefail

# Sync the first line of the focus file into the tmux option @focus.
# Only writes when the content actually changes to avoid extra redraw.

command -v tmux >/dev/null 2>&1 || exit 0

f="$(tmux show -gv @focus_file 2>/dev/null || true)"
[ -n "$f" ] || f="$HOME/.tmux-focus.md"

[ -f "$f" ] || exit 0

line="$(head -n 1 "$f" 2>/dev/null | tr -d '\r')"
[ -z "$line" ] && line="-"

current="$(tmux show -gv @focus 2>/dev/null || true)"
[ "$line" = "$current" ] || tmux set -g @focus "$line"

