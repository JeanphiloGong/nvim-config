#!/usr/bin/env bash
set -u

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
rewrite_bin="$script_dir/tmux-language-rewrite"

trim_line() {
  printf '%s' "$1" | sed 's/[[:space:]]\+$//'
}

printf "Sentence: "
IFS= read -r input || exit 0
input="$(trim_line "$input")"

if [ -z "$input" ]; then
  tmux display-message "Language: empty input"
  exit 0
fi

printf -v cmd \
  'TMUX_LANG_AUTOPASTE=%q bash %q %q' \
  "0" \
  "$rewrite_bin" \
  "$input"

tmux run-shell -b "$cmd"
