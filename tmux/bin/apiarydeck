#!/usr/bin/env python3
import argparse
import html
import json
import os
import re
import sys
import tempfile
from datetime import datetime, timezone


def now():
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds")


def fail(message):
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(1)


def slug(value):
    value = value or "manual"
    value = re.sub(r"[/\s:]+", "_", value)
    value = re.sub(r"[^A-Za-z0-9._-]", "", value)
    return value or "manual"


def default_root():
    if os.environ.get("APIARYDECK_STATE_ROOT"):
        return os.environ["APIARYDECK_STATE_ROOT"]
    state_home = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(state_home, "apiarydeck", slug(os.getcwd()))


class Store:
    def __init__(self, root):
        self.root = root
        self.meta_file = os.path.join(root, "meta.json")
        self.agents_file = os.path.join(root, "agents.json")
        self.tasks_file = os.path.join(root, "tasks.json")
        self.events_file = os.path.join(root, "events.jsonl")

    def ensure(self):
        os.makedirs(self.root, exist_ok=True)
        if not os.path.exists(self.meta_file):
            self.write_json(
                self.meta_file,
                {
                    "product": "ApiaryDeck",
                    "created_at": now(),
                    "updated_at": now(),
                },
            )
        if not os.path.exists(self.agents_file):
            self.write_json(self.agents_file, [])
        if not os.path.exists(self.tasks_file):
            self.write_json(self.tasks_file, [])
        if not os.path.exists(self.events_file):
            with open(self.events_file, "a", encoding="utf-8"):
                pass

    def read_json(self, path, default):
        try:
            with open(path, "r", encoding="utf-8") as fh:
                data = json.load(fh)
        except Exception:
            return default
        return data

    def write_json(self, path, data):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=".tmp.", dir=os.path.dirname(path), text=True)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, ensure_ascii=False, indent=2)
            fh.write("\n")
        os.replace(tmp, path)

    def append_event(self, event):
        os.makedirs(os.path.dirname(self.events_file), exist_ok=True)
        with open(self.events_file, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(event, ensure_ascii=False, separators=(",", ":")))
            fh.write("\n")

    def agents(self):
        data = self.read_json(self.agents_file, [])
        return data if isinstance(data, list) else []

    def tasks(self):
        data = self.read_json(self.tasks_file, [])
        return data if isinstance(data, list) else []

    def events(self):
        events = []
        try:
            with open(self.events_file, "r", encoding="utf-8") as fh:
                for line in fh:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        event = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if isinstance(event, dict):
                        events.append(event)
        except FileNotFoundError:
            pass
        return events


def upsert(items, key, value, record):
    output = [item for item in items if item.get(key) != value]
    output.append(record)
    output.sort(key=lambda item: item.get(key, ""))
    return output


def find_by_id(items, key, value):
    for item in items:
        if item.get(key) == value:
            return item
    fail(f"unknown {key}: {value}")


def next_agent_id(agents, role):
    prefix = slug(role)
    used = {agent.get("agent_id") for agent in agents}
    index = 1
    while f"{prefix}-{index}" in used:
        index += 1
    return f"{prefix}-{index}"


def parse_skill(value):
    name, sep, path = value.partition(":")
    if not sep:
        name, sep, path = value.partition("=")
    if not sep or not name.strip() or not path.strip():
        fail("--skill must use name:path or name=path")
    return {"name": name.strip(), "path": os.path.abspath(os.path.expanduser(path.strip()))}


def sdk_input_payload(task, skills):
    payload = [{"type": "text", "text": task}]
    for skill in skills:
        payload.append({"type": "skill", "name": skill["name"], "path": skill["path"]})
    return payload


def parse_json_object(value, label):
    try:
        data = json.loads(value or "{}")
    except json.JSONDecodeError as exc:
        fail(f"{label} must be valid JSON: {exc}")
    if not isinstance(data, dict):
        fail(f"{label} must be a JSON object")
    return data


def extract_json_object(text):
    text = (text or "").strip()
    if not text:
        return {}
    try:
        data = json.loads(text)
        return data if isinstance(data, dict) else {}
    except json.JSONDecodeError:
        pass
    start = text.find("{")
    end = text.rfind("}")
    if start < 0 or end <= start:
        return {}
    try:
        data = json.loads(text[start : end + 1])
    except json.JSONDecodeError:
        return {}
    return data if isinstance(data, dict) else {}


PLAN_SCHEMA = {
    "type": "object",
    "properties": {
        "tasks": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "task_id": {"type": "string"},
                    "title": {"type": "string"},
                    "owner_role": {"type": "string"},
                    "depends_on": {"type": "array", "items": {"type": "string"}},
                    "acceptance": {"type": "string"},
                    "verification": {"type": "string"},
                },
                "required": ["task_id", "title", "owner_role", "depends_on", "acceptance", "verification"],
                "additionalProperties": False,
            },
        }
    },
    "required": ["tasks"],
    "additionalProperties": False,
}


def crown_role_prompt(goal):
    return "\n".join(
        [
            "You are the ApiaryDeck crown orchestration agent.",
            "Role: crown.",
            "You own the plan, task graph, worker dispatch decisions, blockers, handoffs, and final review loop.",
            "Do not do worker implementation directly unless explicitly assigned.",
            "When planning, produce tasks with ids, owner roles, dependencies, acceptance, and verification.",
            "Return a JSON object with a tasks array when asked to plan.",
            f"Goal: {goal}",
        ]
    )


def default_plan_tasks(goal):
    return [
        {
            "task_id": "T1",
            "title": "Plan task graph",
            "owner_role": "crown",
            "depends_on": [],
            "status": "done",
            "goal": goal,
            "acceptance": "Task graph exists with owner roles, dependencies, and verification.",
            "verification": "apiarydeck status shows planned tasks.",
        },
        {
            "task_id": "T2",
            "title": "Dispatch first worker slice",
            "owner_role": "builder",
            "depends_on": ["T1"],
            "status": "ready",
            "goal": goal,
            "acceptance": "A worker-ready task is available for dispatch.",
            "verification": "apiarydeck status shows T2 ready and assigned owner_role builder.",
        },
    ]


def normalize_plan_tasks(goal, plan):
    raw_tasks = plan.get("tasks") if isinstance(plan, dict) else None
    if not isinstance(raw_tasks, list) or not raw_tasks:
        return default_plan_tasks(goal)

    tasks = []
    seen = set()
    for index, item in enumerate(raw_tasks, start=1):
        if not isinstance(item, dict):
            continue
        task_id = str(item.get("task_id") or f"T{index}").strip() or f"T{index}"
        if task_id in seen:
            task_id = f"{task_id}-{index}"
        seen.add(task_id)
        depends_on = item.get("depends_on")
        if not isinstance(depends_on, list):
            depends_on = []
        status = str(item.get("status") or "pending").strip()
        if status not in ("pending", "waiting", "ready", "running", "blocked", "done"):
            status = "pending"
        tasks.append(
            {
                "task_id": task_id,
                "title": str(item.get("title") or task_id).strip() or task_id,
                "owner_role": str(item.get("owner_role") or "builder").strip() or "builder",
                "depends_on": [str(dep).strip() for dep in depends_on if str(dep).strip()],
                "status": status,
                "goal": goal,
                "acceptance": str(item.get("acceptance") or "").strip(),
                "verification": str(item.get("verification") or "").strip(),
            }
        )
    if not tasks:
        return default_plan_tasks(goal)
    refresh_task_readiness(tasks)
    return tasks


def deps_done(task, task_by_id):
    for dep in task.get("depends_on", []):
        dep_task = task_by_id.get(dep)
        if not dep_task or dep_task.get("status") != "done":
            return False
    return True


def refresh_task_readiness(tasks):
    task_by_id = {task.get("task_id"): task for task in tasks}
    for task in tasks:
        if task.get("status") not in ("pending", "waiting", "ready"):
            continue
        task["status"] = "ready" if deps_done(task, task_by_id) else "waiting"


def worker_prompt(task):
    return "\n".join(
        [
            f"You are the ApiaryDeck worker agent for role {task.get('owner_role') or 'worker'}.",
            f"Task id: {task.get('task_id')}",
            f"Task: {task.get('title')}",
            "",
            "Goal:",
            str(task.get("goal") or task.get("title") or ""),
            "",
            "Acceptance:",
            str(task.get("acceptance") or "Complete the assigned task and report a structured handoff."),
            "",
            "Verification:",
            str(task.get("verification") or "Run the smallest relevant check and report it."),
            "",
            "When done, report with apiarydeck handoff.",
        ]
    )


def tmux_send(pane_id, text):
    import subprocess

    load = subprocess.run(
        ["tmux", "load-buffer", "-"],
        input=text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if load.returncode != 0:
        fail(f"failed to load tmux buffer: {load.stderr.strip()}")
    paste = subprocess.run(["tmux", "paste-buffer", "-t", pane_id], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if paste.returncode != 0:
        fail(f"failed to paste to {pane_id}: {paste.stderr.strip()}")
    enter = subprocess.run(["tmux", "send-keys", "-t", pane_id, "Enter"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if enter.returncode != 0:
        fail(f"failed to send Enter to {pane_id}: {enter.stderr.strip()}")


def sandbox_value(name):
    if not name:
        return None
    try:
        from openai_codex import Sandbox
    except ImportError as exc:
        raise RuntimeError("openai_codex is required for non-dry-run execution") from exc
    values = {
        "read-only": Sandbox.read_only,
        "workspace-write": Sandbox.workspace_write,
        "full-access": Sandbox.full_access,
    }
    return values.get(name)


def run_sdk_turn(args, skills, workdir, output_schema=None):
    try:
        from openai_codex import Codex, SkillInput, TextInput
    except ImportError as exc:
        raise RuntimeError("openai_codex is required for non-dry-run execution") from exc

    inputs = [TextInput(args.task)]
    inputs.extend(SkillInput(skill["name"], skill["path"]) for skill in skills)

    with Codex() as codex:
        sandbox = sandbox_value(args.sandbox)
        if args.thread_id:
            thread = codex.thread_resume(args.thread_id, cwd=workdir, sandbox=sandbox)
        else:
            thread = codex.thread_start(cwd=workdir, sandbox=sandbox)
        turn = thread.turn(inputs, output_schema=output_schema)
        result = turn.run()
        return {
            "thread_id": thread.id,
            "turn_id": turn.id,
            "status": "done",
            "final_response": result.final_response,
            "item_count": len(result.items),
        }


def cmd_sdk_run(args):
    store = Store(args.root)
    store.ensure()
    skills = [parse_skill(value) for value in args.skill]
    workdir = os.path.abspath(os.path.expanduser(args.workdir))
    input_payload = sdk_input_payload(args.task, skills)

    if args.dry_run:
        run_result = {
            "thread_id": args.thread_id or f"dry-thread-{args.agent_id}",
            "turn_id": f"dry-turn-{args.task_id or 'manual'}",
            "status": "dry-run",
            "final_response": "",
            "item_count": 0,
        }
    else:
        run_result = run_sdk_turn(args, skills, workdir)

    record = {
        "agent_id": args.agent_id,
        "role": args.role,
        "connector": "codex-sdk",
        "state": run_result["status"],
        "thread_id": run_result["thread_id"],
        "turn_id": run_result["turn_id"],
        "current_task_id": args.task_id,
        "workdir": workdir,
        "skills": skills,
        "updated_at": now(),
    }
    agents = upsert(store.agents(), "agent_id", args.agent_id, record)
    store.write_json(store.agents_file, agents)

    event = {
        "ts": now(),
        "type": "sdk_turn",
        "agent_id": args.agent_id,
        "role": args.role,
        "connector": "codex-sdk",
        "task_id": args.task_id,
        "workdir": workdir,
        "input": input_payload,
        **run_result,
    }
    store.append_event(event)
    print(json.dumps({"root": store.root, "agent": record, "event": event}, ensure_ascii=False, indent=2))


def cmd_orchestrate(args):
    store = Store(args.root)
    store.ensure()
    skills = [parse_skill(value) for value in args.skill]
    workdir = os.path.abspath(os.path.expanduser(args.workdir))
    task_prompt = crown_role_prompt(args.goal)
    input_payload = sdk_input_payload(task_prompt, skills)

    if args.dry_run:
        run_result = {
            "thread_id": args.thread_id or f"dry-thread-{args.agent_id}",
            "turn_id": "dry-turn-orchestrate",
            "status": "dry-run",
            "final_response": json.dumps({"tasks": default_plan_tasks(args.goal)}, ensure_ascii=False),
            "item_count": 0,
        }
    else:
        run_args = argparse.Namespace(
            task=task_prompt,
            sandbox=args.sandbox,
            thread_id=args.thread_id,
        )
        run_result = run_sdk_turn(run_args, skills, workdir, output_schema=PLAN_SCHEMA)

    record = {
        "agent_id": args.agent_id,
        "role": "crown",
        "connector": "codex-sdk",
        "state": run_result["status"],
        "thread_id": run_result["thread_id"],
        "turn_id": run_result["turn_id"],
        "current_goal": args.goal,
        "workdir": workdir,
        "skills": skills,
        "updated_at": now(),
    }
    agents = upsert(store.agents(), "agent_id", args.agent_id, record)
    store.write_json(store.agents_file, agents)

    plan = extract_json_object(run_result.get("final_response", ""))
    planned_tasks = normalize_plan_tasks(args.goal, plan)
    tasks = store.tasks()
    existing_task_ids = {task.get("task_id") for task in tasks}
    planned = [task for task in planned_tasks if task["task_id"] not in existing_task_ids]
    if planned:
        tasks.extend(planned)
        refresh_task_readiness(tasks)
        tasks.sort(key=lambda task: task.get("task_id", ""))
        store.write_json(store.tasks_file, tasks)

    event = {
        "ts": now(),
        "type": "orchestration_plan",
        "agent_id": args.agent_id,
        "role": "crown",
        "connector": "codex-sdk",
        "goal": args.goal,
        "workdir": workdir,
        "input": input_payload,
        "planned_task_ids": [task["task_id"] for task in planned],
        **run_result,
    }
    store.append_event(event)
    print(
        json.dumps(
            {"root": store.root, "orchestrator": record, "planned_tasks": planned, "event": event},
            ensure_ascii=False,
            indent=2,
        )
    )


def cmd_dispatch(args):
    store = Store(args.root)
    store.ensure()
    skills = [parse_skill(value) for value in args.skill]
    tasks = store.tasks()
    refresh_task_readiness(tasks)
    task = find_by_id(tasks, "task_id", args.task_id)
    if task.get("status") != "ready":
        fail(f"task is not ready: {args.task_id} status={task.get('status')}")

    agents = store.agents()
    role = task.get("owner_role") or args.role or "worker"
    agent_id = args.agent_id or next_agent_id(agents, role)
    workdir = os.path.abspath(os.path.expanduser(args.workdir or task.get("workdir") or os.getcwd()))
    prompt = worker_prompt(task)
    connector = args.connector

    if connector == "tmux-pane" and not args.dry_run:
        if not args.pane_id:
            fail("--pane-id is required for tmux-pane dispatch")
        tmux_send(args.pane_id, prompt)

    if connector == "codex-sdk":
        if args.dry_run:
            run_result = {
                "thread_id": args.thread_id or f"dry-thread-{agent_id}",
                "turn_id": f"dry-turn-{args.task_id}",
                "status": "dry-run",
                "final_response": "",
                "item_count": 0,
            }
        else:
            run_args = argparse.Namespace(task=prompt, sandbox=args.sandbox, thread_id=args.thread_id)
            run_result = run_sdk_turn(run_args, skills, workdir)
    else:
        run_result = {
            "thread_id": args.thread_id,
            "turn_id": "",
            "status": "dispatched",
            "final_response": "",
            "item_count": 0,
        }

    agent = {
        "agent_id": agent_id,
        "role": role,
        "connector": connector,
        "state": "busy",
        "thread_id": run_result.get("thread_id", ""),
        "turn_id": run_result.get("turn_id", ""),
        "pane_id": args.pane_id,
        "current_task_id": args.task_id,
        "workdir": workdir,
        "skills": skills,
        "updated_at": now(),
    }
    agents = upsert(agents, "agent_id", agent_id, agent)
    store.write_json(store.agents_file, agents)

    task["status"] = "running"
    task["assigned_agent_id"] = agent_id
    task["connector"] = connector
    task["dispatch_prompt"] = prompt
    task["updated_at"] = now()
    store.write_json(store.tasks_file, tasks)

    event = {
        "ts": now(),
        "type": "dispatch",
        "task_id": args.task_id,
        "agent_id": agent_id,
        "role": role,
        "connector": connector,
        "pane_id": args.pane_id,
        "prompt": prompt,
        **run_result,
    }
    store.append_event(event)
    print(json.dumps({"root": store.root, "task": task, "agent": agent, "event": event}, ensure_ascii=False, indent=2))


def cmd_handoff(args):
    store = Store(args.root)
    store.ensure()
    tasks = store.tasks()
    agents = store.agents()
    task = find_by_id(tasks, "task_id", args.task_id)
    output = parse_json_object(args.output_json, "--output-json")
    task["status"] = args.status
    task["handoff"] = {
        "from": args.from_agent,
        "status": args.status,
        "output": output,
        "updated_at": now(),
    }
    task["updated_at"] = now()
    if args.status == "done":
        for agent in agents:
            if agent.get("agent_id") == args.from_agent:
                agent["state"] = "idle"
                agent["current_task_id"] = ""
                agent["updated_at"] = now()
    refresh_task_readiness(tasks)
    store.write_json(store.tasks_file, tasks)
    store.write_json(store.agents_file, agents)
    event = {
        "ts": now(),
        "type": "handoff",
        "task_id": args.task_id,
        "from": args.from_agent,
        "status": args.status,
        "output": output,
    }
    store.append_event(event)
    print(json.dumps({"root": store.root, "task": task, "event": event}, ensure_ascii=False, indent=2))


def cmd_blocker(args):
    store = Store(args.root)
    store.ensure()
    tasks = store.tasks()
    task = find_by_id(tasks, "task_id", args.task_id)
    task["status"] = "blocked"
    task["blocker"] = {
        "from": args.from_agent,
        "request_type": args.request_type,
        "body": args.body,
        "updated_at": now(),
    }
    task["updated_at"] = now()
    store.write_json(store.tasks_file, tasks)
    event = {
        "ts": now(),
        "type": "blocker",
        "task_id": args.task_id,
        "from": args.from_agent,
        "request_type": args.request_type,
        "body": args.body,
    }
    store.append_event(event)
    print(json.dumps({"root": store.root, "task": task, "event": event}, ensure_ascii=False, indent=2))


def cmd_loop(args):
    store = Store(args.root)
    store.ensure()
    tasks = store.tasks()
    refresh_task_readiness(tasks)
    ready = [task for task in tasks if task.get("status") == "ready"]
    if not ready:
        store.write_json(store.tasks_file, tasks)
        event = {"ts": now(), "type": "crown_loop", "decision": "wait", "reason": "no ready tasks"}
        store.append_event(event)
        print(json.dumps({"root": store.root, "decision": event}, ensure_ascii=False, indent=2))
        return
    task = sorted(ready, key=lambda item: item.get("task_id", ""))[0]
    store.write_json(store.tasks_file, tasks)
    dispatch_args = argparse.Namespace(
        root=args.root,
        task_id=task["task_id"],
        connector=args.connector,
        agent_id="",
        role=task.get("owner_role") or "worker",
        workdir=args.workdir,
        thread_id="",
        pane_id=args.pane_id,
        skill=args.skill,
        sandbox=args.sandbox,
        dry_run=args.dry_run,
    )
    cmd_dispatch(dispatch_args)


def render_dashboard(payload):
    counts = {}
    for task in payload["tasks"]:
        status = task.get("status") or "unknown"
        counts[status] = counts.get(status, 0) + 1
    count_text = " ".join(f"{html.escape(key)}={value}" for key, value in sorted(counts.items()))
    task_rows = "\n".join(
        "<tr><td>{}</td><td>{}</td><td>{}</td><td>{}</td><td>{}</td></tr>".format(
            html.escape(str(task.get("task_id", ""))),
            html.escape(str(task.get("status", ""))),
            html.escape(str(task.get("owner_role", ""))),
            html.escape(str(task.get("assigned_agent_id", ""))),
            html.escape(str(task.get("title", ""))),
        )
        for task in payload["tasks"]
    )
    agent_rows = "\n".join(
        "<tr><td>{}</td><td>{}</td><td>{}</td><td>{}</td><td>{}</td></tr>".format(
            html.escape(str(agent.get("agent_id", ""))),
            html.escape(str(agent.get("role", ""))),
            html.escape(str(agent.get("state", ""))),
            html.escape(str(agent.get("connector", ""))),
            html.escape(str(agent.get("current_task_id", ""))),
        )
        for agent in payload["agents"]
    )
    event_items = "\n".join(
        "<li><strong>{}</strong> {}</li>".format(
            html.escape(str(event.get("type", ""))),
            html.escape(str(event.get("task_id") or event.get("goal") or event.get("decision") or "")),
        )
        for event in payload["events"][-20:]
    )
    return f"""<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ApiaryDeck</title>
  <style>
    body {{ margin: 0; font: 14px/1.45 system-ui, sans-serif; color: #202124; background: #f7f8fa; }}
    header {{ padding: 16px 24px; background: #ffffff; border-bottom: 1px solid #dfe3e8; }}
    main {{ padding: 20px 24px; display: grid; grid-template-columns: 2fr 1fr; gap: 20px; }}
    section {{ background: #ffffff; border: 1px solid #dfe3e8; border-radius: 8px; padding: 16px; }}
    h1, h2 {{ margin: 0 0 12px; }}
    table {{ width: 100%; border-collapse: collapse; }}
    th, td {{ text-align: left; border-bottom: 1px solid #edf0f3; padding: 8px; vertical-align: top; }}
    .meta {{ color: #5f6b7a; }}
    @media (max-width: 760px) {{ main {{ grid-template-columns: 1fr; padding: 12px; }} }}
  </style>
</head>
<body>
  <header>
    <h1>ApiaryDeck</h1>
    <div class="meta">{html.escape(payload["root"])} · {count_text}</div>
  </header>
  <main>
    <section>
      <h2>Tasks</h2>
      <table><thead><tr><th>ID</th><th>Status</th><th>Owner</th><th>Agent</th><th>Title</th></tr></thead><tbody>{task_rows}</tbody></table>
    </section>
    <section>
      <h2>Agents</h2>
      <table><thead><tr><th>ID</th><th>Role</th><th>State</th><th>Connector</th><th>Task</th></tr></thead><tbody>{agent_rows}</tbody></table>
      <h2>Events</h2>
      <ul>{event_items}</ul>
    </section>
  </main>
</body>
</html>
"""


def cmd_dashboard(args):
    store = Store(args.root)
    store.ensure()
    payload = {
        "root": store.root,
        "agents": store.agents(),
        "tasks": store.tasks(),
        "events": store.events(),
    }
    output = os.path.abspath(os.path.expanduser(args.output or os.path.join(store.root, "dashboard.html")))
    os.makedirs(os.path.dirname(output), exist_ok=True)
    with open(output, "w", encoding="utf-8") as fh:
        fh.write(render_dashboard(payload))
    print(output)


def cmd_status(args):
    store = Store(args.root)
    store.ensure()
    events = store.events()
    payload = {
        "root": store.root,
        "agents": store.agents(),
        "tasks": store.tasks(),
        "events": events[-args.limit :],
    }
    print(json.dumps(payload, ensure_ascii=False, indent=2))


def build_parser():
    parser = argparse.ArgumentParser(description="ApiaryDeck local control helper")
    parser.add_argument("--root", default=default_root(), help="ApiaryDeck state root")
    sub = parser.add_subparsers(dest="command", required=True)

    sdk_run = sub.add_parser("sdk-run", help="Run or dry-run a Codex SDK agent turn")
    sdk_run.add_argument("--agent-id", required=True)
    sdk_run.add_argument("--role", default="worker")
    sdk_run.add_argument("--task-id", default="")
    sdk_run.add_argument("--task", required=True)
    sdk_run.add_argument("--workdir", default=os.getcwd())
    sdk_run.add_argument("--thread-id", default="")
    sdk_run.add_argument("--skill", action="append", default=[], help="Skill as name:path or name=path")
    sdk_run.add_argument("--sandbox", choices=["read-only", "workspace-write", "full-access"], default="workspace-write")
    sdk_run.add_argument("--dry-run", action="store_true")
    sdk_run.set_defaults(func=cmd_sdk_run)

    orchestrate = sub.add_parser("orchestrate", help="Start or dry-run a Crown orchestration turn")
    orchestrate.add_argument("--agent-id", default="crown-1")
    orchestrate.add_argument("--goal", required=True)
    orchestrate.add_argument("--workdir", default=os.getcwd())
    orchestrate.add_argument("--thread-id", default="")
    orchestrate.add_argument("--skill", action="append", default=[], help="Skill as name:path or name=path")
    orchestrate.add_argument("--sandbox", choices=["read-only", "workspace-write", "full-access"], default="workspace-write")
    orchestrate.add_argument("--dry-run", action="store_true")
    orchestrate.set_defaults(func=cmd_orchestrate)

    dispatch = sub.add_parser("dispatch", help="Dispatch a ready task to an SDK or tmux connector")
    dispatch.add_argument("--task-id", required=True)
    dispatch.add_argument("--connector", choices=["codex-sdk", "tmux-pane"], default="codex-sdk")
    dispatch.add_argument("--agent-id", default="")
    dispatch.add_argument("--role", default="")
    dispatch.add_argument("--workdir", default=os.getcwd())
    dispatch.add_argument("--thread-id", default="")
    dispatch.add_argument("--pane-id", default="")
    dispatch.add_argument("--skill", action="append", default=[], help="Skill as name:path or name=path")
    dispatch.add_argument("--sandbox", choices=["read-only", "workspace-write", "full-access"], default="workspace-write")
    dispatch.add_argument("--dry-run", action="store_true")
    dispatch.set_defaults(func=cmd_dispatch)

    handoff = sub.add_parser("handoff", help="Record a worker handoff")
    handoff.add_argument("--task-id", required=True)
    handoff.add_argument("--from", dest="from_agent", required=True)
    handoff.add_argument("--status", choices=["done", "blocked", "waiting"], default="done")
    handoff.add_argument("--output-json", default="{}")
    handoff.set_defaults(func=cmd_handoff)

    blocker = sub.add_parser("blocker", help="Record a blocker or review finding")
    blocker.add_argument("--task-id", required=True)
    blocker.add_argument("--from", dest="from_agent", required=True)
    blocker.add_argument("--request-type", default="implementation_question")
    blocker.add_argument("--body", required=True)
    blocker.set_defaults(func=cmd_blocker)

    loop = sub.add_parser("loop", help="Run one Crown scheduling loop")
    loop.add_argument("--once", action="store_true", help="Run one loop iteration")
    loop.add_argument("--connector", choices=["codex-sdk", "tmux-pane"], default="codex-sdk")
    loop.add_argument("--workdir", default=os.getcwd())
    loop.add_argument("--pane-id", default="")
    loop.add_argument("--skill", action="append", default=[], help="Skill as name:path or name=path")
    loop.add_argument("--sandbox", choices=["read-only", "workspace-write", "full-access"], default="workspace-write")
    loop.add_argument("--dry-run", action="store_true")
    loop.set_defaults(func=cmd_loop)

    dashboard = sub.add_parser("dashboard", help="Write a local HTML dashboard")
    dashboard.add_argument("--output", default="")
    dashboard.set_defaults(func=cmd_dashboard)

    status = sub.add_parser("status", help="Print ApiaryDeck state")
    status.add_argument("--limit", type=int, default=20)
    status.set_defaults(func=cmd_status)

    return parser


def main():
    args = build_parser().parse_args()
    try:
        args.func(args)
    except RuntimeError as exc:
        fail(str(exc))


if __name__ == "__main__":
    main()
