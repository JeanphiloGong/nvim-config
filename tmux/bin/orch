#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  orch init [--root PATH] [--project NAME]
  orch register-window [--root PATH] [--window-id ID] [--window-name NAME] [--worktree-path PATH] [--branch NAME] [--task TEXT] [--phase NAME] [--status STATUS] [--depends-on JSON]
  orch register-pane [--root PATH] [--pane-id ID] [--window-id ID] --role ROLE [--scope SCOPE] [--phase NAME] [--status STATUS] [--forked-from-session-id ID]
  orch handoff [--root PATH] [--window-id ID] [--phase NAME] [--from-pane-id ID] [--to-pane-id ID] [--from-role ROLE] [--to-role ROLE] --type TYPE [--payload-json JSON]
  orch status [--root PATH]
  orch validate [--root PATH]

Notes:
  - Default state root: ${XDG_STATE_HOME:-$HOME/.local/state}/tmux-orch/<session_name>
  - Phase A is session-scoped and fits single task-window flows.
  - Shared project roots and phase lifecycle automation are deferred to later phases.
  - Machine routing uses tmux pane_id. Pane titles are display-only.
  - State files are durable records; live routing remains a tmux/skill concern.
EOF
}

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

iso_now() {
  date '+%Y-%m-%dT%H:%M:%S%z' | sed 's/\(..\)$/:\1/'
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

sanitize_name() {
  printf '%s' "$1" | tr '/ :\t' '____' | tr -cd 'A-Za-z0-9._-'
}

tmux_session_name() {
  tmux display-message -p '#S' 2>/dev/null || true
}

tmux_window_id() {
  tmux display-message -p '#{window_id}' 2>/dev/null || true
}

tmux_window_name() {
  tmux display-message -p '#W' 2>/dev/null || true
}

tmux_pane_id() {
  tmux display-message -p '#{pane_id}' 2>/dev/null || true
}

default_state_root() {
  local base session
  base="${TMUX_ORCH_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/tmux-orch}"
  session="manual"
  if command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}" ]; then
    session="$(tmux_session_name)"
  fi
  session="$(sanitize_name "${session:-manual}")"
  [ -n "$session" ] || session="manual"
  printf '%s/%s' "$base" "$session"
}

resolve_root_arg() {
  local root=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --root)
        [ $# -ge 2 ] || fail "--root requires a value"
        root="$2"
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done
  if [ -n "$root" ]; then
    printf '%s\n' "$root"
  else
    default_state_root
  fi
}

STATE_ROOT=""
PROJECT_FILE=""
WINDOWS_FILE=""
PANES_FILE=""
HANDOFFS_FILE=""
PHASES_FILE=""

init_state_paths() {
  STATE_ROOT="$1"
  PROJECT_FILE="$STATE_ROOT/project-state.json"
  WINDOWS_FILE="$STATE_ROOT/windows.json"
  PANES_FILE="$STATE_ROOT/panes.json"
  HANDOFFS_FILE="$STATE_ROOT/handoffs.jsonl"
  PHASES_FILE="$STATE_ROOT/phases.jsonl"
}

ensure_state_dir() {
  mkdir -p "$STATE_ROOT"
  [ -f "$PROJECT_FILE" ] || printf '{}\n' >"$PROJECT_FILE"
  [ -f "$WINDOWS_FILE" ] || printf '[]\n' >"$WINDOWS_FILE"
  [ -f "$PANES_FILE" ] || printf '[]\n' >"$PANES_FILE"
  [ -f "$HANDOFFS_FILE" ] || : >"$HANDOFFS_FILE"
  [ -f "$PHASES_FILE" ] || : >"$PHASES_FILE"
}

LOCK_ACQUIRED=0
acquire_lock() {
  if [ "$LOCK_ACQUIRED" -eq 1 ]; then
    return 0
  fi
  if command -v flock >/dev/null 2>&1; then
    exec 9>"$STATE_ROOT/.lock"
    flock -w 5 9 || fail "failed to acquire state lock"
  fi
  LOCK_ACQUIRED=1
}

write_json_atomic() {
  local file="$1"
  local content="$2"
  local tmp
  tmp="$(mktemp "$STATE_ROOT/.tmp.XXXXXX")"
  printf '%s\n' "$content" >"$tmp"
  mv "$tmp" "$file"
}

json_upsert() {
  local file="$1"
  local key_name="$2"
  local key_value="$3"
  local record="$4"
  local sort_key="$5"
  local tmp
  tmp="$(mktemp "$STATE_ROOT/.tmp.XXXXXX")"
  jq --arg key_name "$key_name" \
    --arg key_value "$key_value" \
    --arg sort_key "$sort_key" \
    --argjson record "$record" \
    'map(select(.[$key_name] != $key_value)) + [$record] | sort_by(.[$sort_key])' \
    "$file" >"$tmp"
  mv "$tmp" "$file"
}

append_jsonl() {
  local file="$1"
  local line="$2"
  printf '%s\n' "$line" >>"$file"
}

append_failure_lines() {
  local output="$1"
  local line
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    failures+=("$line")
  done <<EOF
$output
EOF
}

git_branch_for_path() {
  local path="$1"
  git -C "$path" symbolic-ref --quiet --short HEAD 2>/dev/null || true
}

infer_project_name() {
  local path="${1:-$PWD}"
  basename "$path"
}

load_project_state() {
  jq -c '.' "$PROJECT_FILE"
}

require_tmux() {
  [ -n "${TMUX:-}" ] || fail "this command requires a tmux session or explicit ids"
  need_cmd tmux
}

cmd_init() {
  local root project session now project_json
  root="$(resolve_root_arg "$@")"
  project=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --project)
        [ $# -ge 2 ] || fail "--project requires a value"
        project="$2"
        shift 2
        ;;
      --root)
        shift 2
        ;;
      *)
        fail "unknown argument for init: $1"
        ;;
    esac
  done

  init_state_paths "$root"
  ensure_state_dir
  acquire_lock

  session="manual"
  if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    session="$(tmux_session_name)"
  fi
  [ -n "$session" ] || session="manual"
  [ -n "$project" ] || project="$(infer_project_name)"
  now="$(iso_now)"
  if command -v jq >/dev/null 2>&1; then
    project_json="$(jq \
      --arg project "$project" \
      --arg session "$session" \
      --arg now "$now" \
      '.project = (.project // $project)
       | .session_name = (.session_name // $session)
       | .project_orchestrator_window = (.project_orchestrator_window // "")
       | .current_phase = (.current_phase // "")
       | .updated_at = $now' \
      "$PROJECT_FILE")"
  else
    project_json="$(printf '{"project":"%s","session_name":"%s","project_orchestrator_window":"","current_phase":"","updated_at":"%s"}' \
      "$(json_escape "$project")" \
      "$(json_escape "$session")" \
      "$(json_escape "$now")")"
  fi
  write_json_atomic "$PROJECT_FILE" "$project_json"
  printf 'Initialized tmux-orch state at %s\n' "$STATE_ROOT"
}

cmd_register_window() {
  local root window_id window_name worktree_path branch task phase status depends_on_json
  local now session project project_json record
  root="$(resolve_root_arg "$@")"
  init_state_paths "$root"
  ensure_state_dir
  acquire_lock
  need_cmd jq

  window_id=""
  window_name=""
  worktree_path=""
  branch=""
  task=""
  phase=""
  status="active"
  depends_on_json='[]'

  while [ $# -gt 0 ]; do
    case "$1" in
      --root)
        shift 2
        ;;
      --window-id)
        window_id="$2"
        shift 2
        ;;
      --window-name)
        window_name="$2"
        shift 2
        ;;
      --worktree-path)
        worktree_path="$2"
        shift 2
        ;;
      --branch)
        branch="$2"
        shift 2
        ;;
      --task)
        task="$2"
        shift 2
        ;;
      --phase)
        phase="$2"
        shift 2
        ;;
      --status)
        status="$2"
        shift 2
        ;;
      --depends-on)
        depends_on_json="$(printf '%s' "$2" | jq -c '.')"
        shift 2
        ;;
      *)
        fail "unknown argument for register-window: $1"
        ;;
    esac
  done

  if [ -z "$window_id" ] || [ -z "$window_name" ]; then
    require_tmux
  fi
  [ -n "$window_id" ] || window_id="$(tmux_window_id)"
  [ -n "$window_name" ] || window_name="$(tmux_window_name)"
  [ -n "$worktree_path" ] || worktree_path="$PWD"
  [ -n "$branch" ] || branch="$(git_branch_for_path "$worktree_path")"

  now="$(iso_now)"
  session="manual"
  if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    session="$(tmux_session_name)"
  fi
  [ -n "$session" ] || session="manual"

  record="$(jq -n \
    --arg session_name "$session" \
    --arg window_id "$window_id" \
    --arg window_name "$window_name" \
    --arg worktree_path "$worktree_path" \
    --arg branch "$branch" \
    --arg task "$task" \
    --arg status "$status" \
    --arg phase "$phase" \
    --arg updated_at "$now" \
    --argjson depends_on "$depends_on_json" \
    '{
      session_name: $session_name,
      window_id: $window_id,
      window_name: $window_name,
      worktree_path: $worktree_path,
      branch: $branch,
      task: $task,
      status: $status,
      phase: $phase,
      depends_on: $depends_on,
      updated_at: $updated_at
    }')"
  json_upsert "$WINDOWS_FILE" "window_id" "$window_id" "$record" "window_id"

  project="$(infer_project_name "$worktree_path")"
  project_json="$(jq \
    --arg project "$project" \
    --arg session "$session" \
    --arg now "$now" \
    --arg phase "$phase" \
    '.project = (.project // $project)
     | .session_name = (.session_name // $session)
     | .current_phase = (if $phase != "" then $phase else (.current_phase // "") end)
     | .updated_at = $now' \
    "$PROJECT_FILE")"
  write_json_atomic "$PROJECT_FILE" "$project_json"
  printf 'Registered window %s (%s)\n' "$window_id" "$window_name"
}

cmd_register_pane() {
  local root pane_id window_id role scope phase status forked_from_session_id
  local session now record
  root="$(resolve_root_arg "$@")"
  init_state_paths "$root"
  ensure_state_dir
  acquire_lock
  need_cmd jq

  pane_id=""
  window_id=""
  role=""
  scope=""
  phase=""
  status="active"
  forked_from_session_id=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --root)
        shift 2
        ;;
      --pane-id)
        pane_id="$2"
        shift 2
        ;;
      --window-id)
        window_id="$2"
        shift 2
        ;;
      --role)
        role="$2"
        shift 2
        ;;
      --scope)
        scope="$2"
        shift 2
        ;;
      --phase)
        phase="$2"
        shift 2
        ;;
      --status)
        status="$2"
        shift 2
        ;;
      --forked-from-session-id)
        forked_from_session_id="$2"
        shift 2
        ;;
      *)
        fail "unknown argument for register-pane: $1"
        ;;
    esac
  done

  [ -n "$role" ] || fail "register-pane requires --role"
  if [ -z "$pane_id" ] || [ -z "$window_id" ]; then
    require_tmux
  fi
  [ -n "$pane_id" ] || pane_id="$(tmux_pane_id)"
  [ -n "$window_id" ] || window_id="$(tmux_window_id)"
  [ -n "$scope" ] || {
    if [ "$role" = "orchestrator" ]; then
      scope="window"
    else
      scope="phase"
    fi
  }

  session="manual"
  if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    session="$(tmux_session_name)"
  fi
  [ -n "$session" ] || session="manual"
  now="$(iso_now)"

  record="$(jq -n \
    --arg session_name "$session" \
    --arg window_id "$window_id" \
    --arg pane_id "$pane_id" \
    --arg role "$role" \
    --arg scope "$scope" \
    --arg phase "$phase" \
    --arg status "$status" \
    --arg forked_from_session_id "$forked_from_session_id" \
    --arg updated_at "$now" \
    '{
      session_name: $session_name,
      window_id: $window_id,
      pane_id: $pane_id,
      role: $role,
      scope: $scope,
      phase: $phase,
      status: $status,
      forked_from_session_id: $forked_from_session_id,
      updated_at: $updated_at
    }')"
  json_upsert "$PANES_FILE" "pane_id" "$pane_id" "$record" "pane_id"
  printf 'Registered pane %s (%s)\n' "$pane_id" "$role"
}

cmd_handoff() {
  local root window_id phase from_pane_id to_pane_id from_role to_role type payload_json
  local now session line
  root="$(resolve_root_arg "$@")"
  init_state_paths "$root"
  ensure_state_dir
  acquire_lock
  need_cmd jq

  window_id=""
  phase=""
  from_pane_id=""
  to_pane_id=""
  from_role=""
  to_role=""
  type=""
  payload_json='{}'

  while [ $# -gt 0 ]; do
    case "$1" in
      --root)
        shift 2
        ;;
      --window-id)
        window_id="$2"
        shift 2
        ;;
      --phase)
        phase="$2"
        shift 2
        ;;
      --from-pane-id)
        from_pane_id="$2"
        shift 2
        ;;
      --to-pane-id)
        to_pane_id="$2"
        shift 2
        ;;
      --from-role)
        from_role="$2"
        shift 2
        ;;
      --to-role)
        to_role="$2"
        shift 2
        ;;
      --type)
        type="$2"
        shift 2
        ;;
      --payload-json)
        payload_json="$(printf '%s' "$2" | jq -c '.')"
        shift 2
        ;;
      *)
        fail "unknown argument for handoff: $1"
        ;;
    esac
  done

  [ -n "$type" ] || fail "handoff requires --type"
  if [ -z "$from_pane_id" ] || [ -z "$window_id" ]; then
    require_tmux
  fi
  [ -n "$from_pane_id" ] || from_pane_id="$(tmux_pane_id)"
  [ -n "$window_id" ] || window_id="$(tmux_window_id)"
  [ -n "$to_pane_id" ] || fail "handoff requires --to-pane-id"

  session="manual"
  if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    session="$(tmux_session_name)"
  fi
  [ -n "$session" ] || session="manual"
  now="$(iso_now)"

  line="$(jq -cn \
    --arg ts "$now" \
    --arg session_name "$session" \
    --arg window_id "$window_id" \
    --arg phase "$phase" \
    --arg from_pane_id "$from_pane_id" \
    --arg to_pane_id "$to_pane_id" \
    --arg from_role "$from_role" \
    --arg to_role "$to_role" \
    --arg type "$type" \
    --argjson payload "$payload_json" \
    '{
      ts: $ts,
      session_name: $session_name,
      window_id: $window_id,
      phase: $phase,
      from_pane_id: $from_pane_id,
      to_pane_id: $to_pane_id,
      from_role: $from_role,
      to_role: $to_role,
      type: $type,
      payload: $payload
    }')"
  append_jsonl "$HANDOFFS_FILE" "$line"
  printf 'Recorded handoff %s -> %s (%s)\n' "$from_pane_id" "$to_pane_id" "$type"
}

cmd_status() {
  local root project session phase windows_count panes_count
  root="$(resolve_root_arg "$@")"
  init_state_paths "$root"
  ensure_state_dir
  need_cmd jq

  project="$(jq -r '.project // "-"' "$PROJECT_FILE")"
  session="$(jq -r '.session_name // "-"' "$PROJECT_FILE")"
  phase="$(jq -r '.current_phase // "-"' "$PROJECT_FILE")"
  windows_count="$(jq 'length' "$WINDOWS_FILE")"
  panes_count="$(jq 'length' "$PANES_FILE")"

  printf 'Project: %s\n' "$project"
  printf 'Session: %s\n' "$session"
  printf 'Phase: %s\n' "$phase"
  printf 'State Root: %s\n' "$STATE_ROOT"
  printf '\nWindows (%s):\n' "$windows_count"
  jq -r 'if length == 0 then "- none" else .[] | "- \(.window_id) \(.window_name) \(.status // "-") \(.phase // "-") \(.worktree_path)" end' "$WINDOWS_FILE"
  printf '\nPanes (%s):\n' "$panes_count"
  jq -r 'if length == 0 then "- none" else .[] | "- \(.window_id) \(.pane_id) \(.role) \(.status // "-") \(.phase // "-")" end' "$PANES_FILE"
  printf '\nRecent Handoffs:\n'
  if [ -s "$HANDOFFS_FILE" ]; then
    tail -n 5 "$HANDOFFS_FILE" | jq -r '"- \(.ts) \(.from_pane_id) -> \(.to_pane_id) \(.type)"'
  else
    printf '%s\n' '- none'
  fi
}

cmd_validate() {
  local root
  local failures=()
  local output=""
  root="$(resolve_root_arg "$@")"
  init_state_paths "$root"
  ensure_state_dir
  need_cmd jq

  output="$(
    jq -r --slurpfile panes "$PANES_FILE" '
      .[] | . as $window |
      ($panes[0] | map(select(.window_id == $window.window_id and .role == "orchestrator" and .status == "active")) | length) as $count |
      select($count != 1) |
      "window \($window.window_id): expected exactly 1 active orchestrator, got \($count)"
    ' "$WINDOWS_FILE"
  )" || fail "validate: failed to evaluate orchestrator invariant"
  append_failure_lines "$output"

  output="$(
    jq -r '
      .[] |
      select(.status == "active" and .role != "orchestrator" and ((.forked_from_session_id // "") == "")) |
      "pane \(.pane_id): active \(.role) missing forked_from_session_id"
    ' "$PANES_FILE"
  )" || fail "validate: failed to evaluate pane fork provenance invariant"
  append_failure_lines "$output"

  output="$(
    jq -r --slurpfile windows "$WINDOWS_FILE" '
      .[] as $pane |
      select(([$windows[0][] | .window_id] | index($pane.window_id)) == null) |
      "pane \($pane.pane_id): references unknown window_id \($pane.window_id)"
    ' "$PANES_FILE"
  )" || fail "validate: failed to evaluate pane window reference invariant"
  append_failure_lines "$output"

  if [ -s "$HANDOFFS_FILE" ]; then
    while IFS= read -r raw; do
      [ -n "$raw" ] || continue
      local_from="$(printf '%s' "$raw" | jq -r '.from_pane_id // empty' 2>/dev/null || true)"
      local_to="$(printf '%s' "$raw" | jq -r '.to_pane_id // empty' 2>/dev/null || true)"
      if [ -n "$local_from" ] && ! jq -e --arg pane "$local_from" 'map(select(.pane_id == $pane)) | length > 0' "$PANES_FILE" >/dev/null 2>&1; then
        failures+=("handoff references unknown from_pane_id $local_from")
      fi
      if [ -n "$local_to" ] && ! jq -e --arg pane "$local_to" 'map(select(.pane_id == $pane)) | length > 0' "$PANES_FILE" >/dev/null 2>&1; then
        failures+=("handoff references unknown to_pane_id $local_to")
      fi
    done <"$HANDOFFS_FILE"
  fi

  if [ "${#failures[@]}" -gt 0 ]; then
    printf 'tmux-orch validate: FAIL\n' >&2
    for failure in "${failures[@]}"; do
      printf -- '- %s\n' "$failure" >&2
    done
    exit 1
  fi

  printf 'tmux-orch validate: OK\n'
}

main() {
  local cmd="${1:-}"
  [ -n "$cmd" ] || {
    usage
    exit 0
  }
  shift || true

  case "$cmd" in
    init)
      cmd_init "$@"
      ;;
    register-window)
      cmd_register_window "$@"
      ;;
    register-pane)
      cmd_register_pane "$@"
      ;;
    handoff)
      cmd_handoff "$@"
      ;;
    status)
      cmd_status "$@"
      ;;
    validate)
      cmd_validate "$@"
      ;;
    help | --help | -h)
      usage
      ;;
    *)
      fail "unknown command: $cmd"
      ;;
  esac
}

main "$@"
